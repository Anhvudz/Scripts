local function loadJSON(file)
	if not isfile(file) then return {} end
	local ok, d = pcall(httpService.JSONDecode, httpService, readfile(file))
	return (ok and type(d) == "table") and d or {}
end
local function saveJSON(file, data) pcall(writefile, file, httpService:JSONEncode(data)) end

local cfg     = loadJSON(SETTINGS_FILE)
for k, v in pairs(DEFAULT) do if cfg[k] == nil then cfg[k] = v end end
local saveCfg = function() saveJSON(SETTINGS_FILE, cfg) end

local scripts    = loadJSON(SCRIPTS_FILE)
