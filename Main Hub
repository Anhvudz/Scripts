	codeBox.Size=UDim2.new(1,-12,1,-8); codeBox.Position=UDim2.new(0,6,0,4)
	codeBox.MultiLine=true; codeBox.ClearTextOnFocus=false
	codeBox.Text=preloadCode or "-- Potassium Hub Code Editor\n-- Gõ code Luau ở đây. Gõ trigger và dừng lại để xem gợi ý.\n\n"
	codeBox.TextColor3=Color3.fromRGB(210,210,228)
	codeBox.BackgroundTransparency=1
	codeBox.Font=Enum.Font.Code; codeBox.TextSize=14
	codeBox.TextXAlignment=Enum.TextXAlignment.Left
	codeBox.TextYAlignment=Enum.TextYAlignment.Top
	codeBox.RichText=false; codeBox.Parent=codeScroll

	-- Update gutter + canvas when text changes.
	local function updateLayout()
		local lines = select(2, codeBox.Text:gsub("\n", "\n")) + 1
		local lineH  = 18
		local totalH = math.max(lines * lineH, codeScroll.AbsoluteSize.Y - 8)
		codeBox.Size = UDim2.new(1, -12, 0, totalH)
		codeScroll.CanvasSize = UDim2.new(0, 0, 0, totalH + 8)

		gutter:ClearAllChildren()
		for i = 1, lines do
			local ln = Instance.new("TextLabel")
			ln.Size=UDim2.new(1,-5,0,lineH); ln.Position=UDim2.new(0,0,0,(i-1)*lineH)
			ln.Text=tostring(i); ln.TextColor3=Color3.fromRGB(72,72,98)
			ln.BackgroundTransparency=1; ln.Font=Enum.Font.Code; ln.TextSize=13
			ln.TextXAlignment=Enum.TextXAlignment.Right; ln.Parent=gutter
		end
		gutter.CanvasSize=UDim2.new(0,0,0,lines*lineH)
	end
	codeBox:GetPropertyChangedSignal("Text"):Connect(updateLayout)
	task.defer(updateLayout)

	-- Suggestion panel (autocomplete).
	local suggFrame = Instance.new("Frame")
	suggFrame.Size=UDim2.new(0,340,0,0); suggFrame.Position=UDim2.new(0,42,0,34)
	suggFrame.BackgroundColor3=Color3.fromRGB(22,22,32); suggFrame.BorderSizePixel=0
	suggFrame.Visible=false; suggFrame.ZIndex=20; suggFrame.Parent=win
	mkCorner(suggFrame, 5); mkStroke(suggFrame, Color3.fromRGB(50,50,70), 1)

	local suggList = {}  -- current suggestions
	local lastWord = ""

	local function hideSugg() suggFrame.Visible=false end

	local function showSuggestions(word)
		lastWord = word
		if #word < 2 then hideSugg(); return end

		local matches = {}
		for _, s in ipairs(SNIPPETS) do
			local t = s.trigger
			if t:sub(1,#word)==word or (#word>=#t and word:sub(1,#t)==t) then
				table.insert(matches, s)
				if #matches >= 6 then break end
			end
		end
		if #matches==0 then hideSugg(); return end

		-- Clear old buttons.
		for _, c in ipairs(suggFrame:GetChildren()) do
			if c:IsA("TextButton") or c:IsA("Frame") then c:Destroy() end
		end

		local ITEM_H = 26
		for i, match in ipairs(matches) do
			local isFirst = i == 1
			local rowBg = isFirst and Color3.fromRGB(35,35,55) or Color3.fromRGB(22,22,32)

			local row = Instance.new("TextButton")
			row.Size=UDim2.new(1,0,0,ITEM_H); row.Position=UDim2.new(0,0,0,(i-1)*ITEM_H)
			row.BackgroundColor3=rowBg; row.BorderSizePixel=0; row.Text=""; row.ZIndex=21; row.Parent=suggFrame
			if isFirst then mkCorner(row, 5) end

			-- Trigger badge.
			local badge = Instance.new("TextLabel")
			badge.Size=UDim2.new(0,70,1,0); badge.Position=UDim2.new(0,6,0,0)
			badge.Text=match.trigger; badge.TextColor3=Color3.fromRGB(100,180,255)
			badge.BackgroundTransparency=1; badge.Font=Enum.Font.Code; badge.TextSize=12
			badge.TextXAlignment=Enum.TextXAlignment.Left; badge.ZIndex=22; badge.Parent=row

			-- Arrow.
			local arrow = Instance.new("TextLabel")
			arrow.Size=UDim2.new(0,16,1,0); arrow.Position=UDim2.new(0,78,0,0)
			arrow.Text="→"; arrow.TextColor3=Color3.fromRGB(80,80,100)
			arrow.BackgroundTransparency=1; arrow.Font=Enum.Font.SourceSans; arrow.TextSize=12
			arrow.ZIndex=22; arrow.Parent=row

			-- Description.
			local desc = Instance.new("TextLabel")
			desc.Size=UDim2.new(1,-100,1,0); desc.Position=UDim2.new(0,96,0,0)
			desc.Text=match.label; desc.TextColor3=Color3.fromRGB(175,175,195)
			desc.BackgroundTransparency=1; desc.Font=Enum.Font.SourceSans; desc.TextSize=12
			desc.TextXAlignment=Enum.TextXAlignment.Left; desc.TextTruncate=Enum.TextTruncate.AtEnd
			desc.ZIndex=22; desc.Parent=row

			row.MouseEnter:Connect(function()
				tweenService:Create(row,TweenInfo.new(0.08),{BackgroundColor3=Color3.fromRGB(45,45,68)}):Play()
			end)
			row.MouseLeave:Connect(function()
				tweenService:Create(row,TweenInfo.new(0.08),{BackgroundColor3=rowBg}):Play()
			end)

			local insertText = match.insert
			row.MouseButton1Click:Connect(function()
				local text = codeBox.Text
				-- Remove trigger word and insert completion.
				if lastWord ~= "" then text = text:sub(1, -(#lastWord+1)) end
				codeBox.Text = text .. insertText
				hideSugg()
				codeBox:CaptureFocus()
			end)
		end

		suggFrame.Size = UDim2.new(0, 340, 0, #matches * ITEM_H)
		suggFrame.Visible = true
	end

	-- Debounced autocomplete trigger.
	local debounceThread = nil
	codeBox:GetPropertyChangedSignal("Text"):Connect(function()
		if debounceThread then task.cancel(debounceThread) end
		debounceThread = task.delay(0.18, function()
			local text = codeBox.Text
			local word  = text:match("[%w%.%:_]+$") or ""
			showSuggestions(word)
		end)
	end)

	-- ESC closes suggestions.
	userInput.InputBegan:Connect(function(i, gp)
		if gp then return end
		if i.KeyCode == Enum.KeyCode.Escape then hideSugg() end
	end)

	-- Bottom toolbar.
	local toolbar = Instance.new("Frame")
	toolbar.Size=UDim2.new(1,0,0,36); toolbar.Position=UDim2.new(0,0,1,-36)
	toolbar.BackgroundColor3=Color3.fromRGB(18,18,26); toolbar.BorderSizePixel=0; toolbar.Parent=win
	mkCorner(toolbar, 8)
	local tbFix2 = Instance.new("Frame"); tbFix2.Size=UDim2.new(1,0,0,8)
	tbFix2.BackgroundColor3=Color3.fromRGB(18,18,26); tbFix2.BorderSizePixel=0; tbFix2.Parent=toolbar

	local topLine = Instance.new("Frame"); topLine.Size=UDim2.new(1,0,0,1)
	topLine.BackgroundColor3=Color3.fromRGB(35,35,48); topLine.BorderSizePixel=0; topLine.Parent=toolbar

	-- Status label.
	local statusLbl = Instance.new("TextLabel")
	statusLbl.Size=UDim2.new(0,160,1,0); statusLbl.Position=UDim2.new(1,-164,0,0)
	statusLbl.Text="●  Ready"; statusLbl.TextColor3=Color3.fromRGB(70,70,95)
	statusLbl.BackgroundTransparency=1; statusLbl.Font=Enum.Font.SourceSans; statusLbl.TextSize=11
	statusLbl.TextXAlignment=Enum.TextXAlignment.Right; statusLbl.ZIndex=6; statusLbl.Parent=toolbar

	local function setStatus(msg, color)
		statusLbl.Text = msg
		tweenService:Create(statusLbl, TweenInfo.new(0.15), {TextColor3 = color or Color3.fromRGB(70,70,95)}):Play()
	end

	-- Toolbar buttons.
	local btnDefs = {
		{ "▶  Run",    Color3.fromRGB(42,168,48) },
		{ "🔍  Check",  Color3.fromRGB(50,135,225) },
		{ "📋  Copy",   Color3.fromRGB(75,75,100) },
		{ "💾  Save",   Color3.fromRGB(95,65,175) },
		{ "🗑  Clear",  Color3.fromRGB(155,40,40) },
	}

	local toolBtns = {}
	for i, def in ipairs(btnDefs) do
		local xOff = 8 + (i-1) * 88
		local btn = mkBtn(toolbar, def[1], def[2],
			UDim2.new(0,84,0,24), UDim2.new(0,xOff,0.5,-12), 6)
		table.insert(toolBtns, btn)
	end

	local runBtn, checkBtn, copyBtn, saveBtn, clearBtn = table.unpack(toolBtns)

	runBtn.MouseButton1Click:Connect(function()
		hideSugg()
		local fn, err = loadstring(codeBox.Text)
		if fn then
			task.spawn(fn)
			setStatus("✅  Running...", Color3.fromRGB(48,195,85))
			MyHub:Notify("Code", "▶  Executed!", 3)
		else
			local e = tostring(err)
			setStatus("❌  " .. e:sub(1,45), Color3.fromRGB(210,50,50))
			MyHub:Notify("Syntax Error", e:sub(1,120), 6)
		end
	end)

	checkBtn.MouseButton1Click:Connect(function()
		hideSugg()
		local fn, err = loadstring(codeBox.Text)
		if fn then
			setStatus("✅  No errors", Color3.fromRGB(48,195,85))
			MyHub:Notify("Check", "✅  Code hợp lệ, không có lỗi!", 4)
		else
			local e = tostring(err)
			setStatus("❌  " .. e:sub(1,45), Color3.fromRGB(210,50,50))
			MyHub:Notify("Syntax Error", e:sub(1,120), 6)
		end
	end)

	copyBtn.MouseButton1Click:Connect(function()
		if not setclipboard then setStatus("⚠️  Unavailable", Color3.fromRGB(210,130,50)); return end
		setclipboard(codeBox.Text)
		setStatus("📋  Copied!", Color3.fromRGB(80,160,255))
	end)

	saveBtn.MouseButton1Click:Connect(function()
		if codeBox.Text:match("^%s*$") then setStatus("⚠️  Empty", Color3.fromRGB(210,130,50)); return end
		local name = "Code_" .. os.date("%m%d_%H%M%S")
		table.insert(scripts, { name=name, code=codeBox.Text, source="editor" })
		saveScripts()
		setStatus("💾  " .. name, Color3.fromRGB(160,90,255))
		MyHub:Notify("Saved", "💾  " .. name, 3)
	end)

	clearBtn.MouseButton1Click:Connect(function()
		hideSugg()
		codeBox.Text = "-- Potassium Hub Code Editor\n\n"
		setStatus("●  Ready", Color3.fromRGB(70,70,95))
	end)

	-- Open animation.
	win.AnchorPoint = Vector2.new(0.5, 0.5)
	win.Position    = UDim2.new(0.5, 0, 0.5, 0)
	win.Size        = UDim2.new(0, 0, 0, 0)
	tweenService:Create(win, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size=UDim2.new(0,560,0,460), BackgroundTransparency=0,
	}):Play()
end

