			local nameL=Instance.new("TextLabel"); nameL.Size=UDim2.new(0,100,1,0); nameL.Position=UDim2.new(0,88,0,0)
			nameL.Text=m.label; nameL.TextColor3=Color3.fromRGB(190,190,210); nameL.BackgroundTransparency=1
			nameL.Font=Enum.Font.SourceSans; nameL.TextSize=12; nameL.TextXAlignment=Enum.TextXAlignment.Left; nameL.ZIndex=22; nameL.Parent=row

			if m.desc then
				local descL=Instance.new("TextLabel"); descL.Size=UDim2.new(1,-200,1,0); descL.Position=UDim2.new(0,196,0,0)
				descL.Text=m.desc; descL.TextColor3=Color3.fromRGB(110,110,140); descL.BackgroundTransparency=1
				descL.Font=Enum.Font.SourceSans; descL.TextSize=10; descL.TextXAlignment=Enum.TextXAlignment.Left
				descL.TextTruncate=Enum.TextTruncate.AtEnd; descL.ZIndex=22; descL.Parent=row
			end

			row.MouseEnter:Connect(function() tweenService:Create(row,TweenInfo.new(0.08),{BackgroundColor3=Color3.fromRGB(38,38,62)}):Play() end)
			row.MouseLeave:Connect(function() tweenService:Create(row,TweenInfo.new(0.08),{BackgroundColor3=isFirst and Color3.fromRGB(32,32,52) or Color3.fromRGB(20,20,30)}):Play() end)

			local ins=m.insert
			local function accept()
				local text=codeBox.Text
				if lastWord~="" then text=text:sub(1,-(#lastWord+1)) end
				codeBox.Text=text..ins; hideSugg(); codeBox:CaptureFocus()
			end
			row.MouseButton1Click:Connect(accept)
		end

		suggFrame.Size=UDim2.new(0,320,0,#matches*IH); suggFrame.Visible=true
	end

