local function autoIndent(source)
	local lines={}
	for ln in (source.."\n"):gmatch("([^\n]*)\n") do table.insert(lines,ln) end
	local out={}; local level=0
	local function trim(s) return s:match("^%s*(.-)%s*$") end
	for _,line in ipairs(lines) do
		local t=trim(line)
		local closes=t:match("^end%f[%A%z]") or t:match("^else%f[%A%z]") or
		             t:match("^elseif%f[%A%z]") or t:match("^until%f[%A%z]")
		if closes then level=math.max(0,level-1) end
		table.insert(out, t~="" and string.rep("\t",level)..t or "")
		if not t:match("^%-%-") then
			local opens=(t:match("%f[%a]do%f[%A%z]") or t:match("then%s*$") or
			             t:match("else%s*$") or t:match("^repeat%s*$") or
			             t:match("function%s*%(") or t:match("function%s+%w"))
			if opens and not closes and not t:match("%f[%a]end%f[%A%z]") then
				level=level+1
			end
		end
	end
	return table.concat(out,"\n")
end

