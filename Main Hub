local ELEMENT_DEFS={
	{pat='NewTab%s*%({[^}]*Name%s*=%s*"([^"]*)"',       icon="TAB", color=Color3.fromRGB(55,145,230)},
	{pat='NewSection%s*%({[^}]*Name%s*=%s*"([^"]*)"',   icon="SEC", color=Color3.fromRGB(80,80,110)},
	{pat='NewButton%s*%({[^}]*Name%s*=%s*"([^"]*)"',    icon="BTN", color=Color3.fromRGB(55,145,230)},
	{pat='NewToggle%s*%({[^}]*Name%s*=%s*"([^"]*)"',    icon="TOG", color=Color3.fromRGB(48,195,85)},
	{pat='NewSlider%s*%({[^}]*Name%s*=%s*"([^"]*)"',    icon="SLD", color=Color3.fromRGB(245,135,40)},
	{pat='NewDropdown%s*%({[^}]*Name%s*=%s*"([^"]*)"',  icon="DRP", color=Color3.fromRGB(160,90,255)},
	{pat='NewColorPicker%s*%({[^}]*Name%s*=%s*"([^"]*)"',icon="CLR",color=Color3.fromRGB(255,100,130)},
	{pat='NewLabel%s*%({[^}]*Name%s*=%s*"([^"]*)"',     icon="LBL", color=Color3.fromRGB(165,165,165)},
	{pat='NewInput%s*%({[^}]*Name%s*=%s*"([^"]*)"',     icon="INP", color=Color3.fromRGB(200,170,30)},
	{pat='NewKeybind%s*%({[^}]*Name%s*=%s*"([^"]*)"',   icon="KEY", color=Color3.fromRGB(100,200,255)},
	{pat='NewProgressBar%s*%({[^}]*Name%s*=%s*"([^"]*)"',icon="PRG",color=Color3.fromRGB(65,195,85)},
	{pat='NewImageLabel%s*%({[^}]*Name%s*=%s*"([^"]*)"',icon="IMG", color=Color3.fromRGB(255,180,50)},
	{pat='NewImageButton%s*%({[^}]*Name%s*=%s*"([^"]*)"',icon="IMB",color=Color3.fromRGB(255,150,30)},
	{pat='NewViewportFrame%s*%({[^}]*Name%s*=%s*"([^"]*)"',icon="VP",color=Color3.fromRGB(150,200,255)},
}

local function parseElements(code)
	local elems={}
	for _,def in ipairs(ELEMENT_DEFS) do
		for name in code:gmatch(def.pat) do
			table.insert(elems,{icon=def.icon,name=name,color=def.color})
		end
	end
	return elems
end

-- GET ERROR LINE from loadstring error message
local function getErrorLine(errMsg)
	local s=tostring(errMsg)
	local line=s:match(":(%d+):")
	return line and tonumber(line) or nil
end

