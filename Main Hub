		if trig=="" or ins=="" then MyHub:Notify("Error","Trigger va Insert khong duoc trong!",3); return end
		table.insert(userSnippets,{trigger=trig,insert=ins,label=labelIn and labelIn.Text~="" and labelIn.Text or trig,
			desc=descIn and descIn.Text~="" and descIn.Text or nil})
		saveSnippets(); MyHub:Notify("Snippet","Da them: "..trig,3)
	end})

	S:NewButton({Name="Xoa snippet cuoi",Callback=function()
		if #userSnippets==0 then MyHub:Notify("Error","Khong co snippet nao!",3); return end
		local last=table.remove(userSnippets); saveSnippets(); MyHub:Notify("Deleted","Da xoa: "..last.trigger,3)
	end})
end

