local function mkCorner(p, r)
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 5); c.Parent = p
end

local function mkStroke(p, color, thickness)
	local s = Instance.new("UIStroke"); s.Color = color or Color3.fromRGB(50,50,60)
	s.Thickness = thickness or 1; s.Parent = p
end

local function mkBtn(parent, text, bgColor, size, pos, zIdx)
	local b = Instance.new("TextButton")
	b.Size = size; b.Position = pos
	b.Text = text; b.TextColor3 = Color3.new(1,1,1); b.BackgroundColor3 = bgColor
	b.Font = Enum.Font.SourceSansBold; b.TextSize = 12; b.BorderSizePixel = 0
	b.ZIndex = zIdx or 5; b.Parent = parent
	mkCorner(b, 4)
	b.MouseEnter:Connect(function() tweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3=bgColor:Lerp(Color3.new(1,1,1),0.1)}):Play() end)
	b.MouseLeave:Connect(function() tweenService:Create(b, TweenInfo.new(0.1), {BackgroundColor3=bgColor}):Play() end)
	return b
end

local function mkLabel(parent, text, size, pos, color, fontSize, font, align, zIdx)
	local l = Instance.new("TextLabel")
	l.Size = size; l.Position = pos; l.Text = text
	l.TextColor3 = color or Color3.fromRGB(200,200,210); l.BackgroundTransparency = 1
	l.Font = font or Enum.Font.SourceSans; l.TextSize = fontSize or 13
	l.TextXAlignment = align or Enum.TextXAlignment.Left; l.ZIndex = zIdx or 5
	l.Parent = parent
	return l
end

local function makeDraggableFrame(dragSrc, targetFrame)
	local dragging, sx, sy, sp = false, 0, 0, nil; local mc, rc
	local function stopDrag()
		dragging = false
		if mc then mc:Disconnect() end; if rc then rc:Disconnect() end
	end
	dragSrc.InputBegan:Connect(function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		dragging = true; sx = i.Position.X; sy = i.Position.Y
		sp = {X={Scale=targetFrame.Position.X.Scale,Offset=targetFrame.Position.X.Offset},
		      Y={Scale=targetFrame.Position.Y.Scale,Offset=targetFrame.Position.Y.Offset}}
		mc = userInput.InputChanged:Connect(function(ic)
			if not dragging or ic.UserInputType ~= Enum.UserInputType.MouseMovement then return end
			targetFrame.Position = UDim2.new(sp.X.Scale,sp.X.Offset+ic.Position.X-sx,sp.Y.Scale,sp.Y.Offset+ic.Position.Y-sy)
		end)
		rc = userInput.InputEnded:Connect(function(ie)
			if ie.UserInputType == Enum.UserInputType.MouseButton1 then stopDrag() end
		end)
	end)
end

