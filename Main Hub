		for i,m in ipairs(matches) do
			local isFirst=i==1
			local row=Instance.new("TextButton"); row.Size=UDim2.new(1,0,0,IH); row.Position=UDim2.new(0,0,0,(i-1)*IH)
			row.BackgroundColor3=isFirst and Color3.fromRGB(28,28,48) or Color3.fromRGB(18,18,30)
			row.BorderSizePixel=0; row.Text=""; row.ZIndex=32; row.Parent=suggFrame
			if isFirst then local rc=Instance.new("UICorner"); rc.CornerRadius=UDim.new(0,4); rc.Parent=row end

			-- Trigger
			local trigL=Instance.new("TextLabel"); trigL.Size=UDim2.new(0,72,1,0); trigL.Position=UDim2.new(0,8,0,0)
			trigL.Text=m.trigger; trigL.TextColor3=Color3.fromRGB(100,175,255); trigL.BackgroundTransparency=1
			trigL.Font=Enum.Font.Code; trigL.TextSize=12; trigL.TextXAlignment=Enum.TextXAlignment.Left; trigL.ZIndex=33; trigL.Parent=row

			-- Label
			local nameL=Instance.new("TextLabel"); nameL.Size=UDim2.new(0,90,1,0); nameL.Position=UDim2.new(0,82,0,0)
			nameL.Text=m.label; nameL.TextColor3=Color3.fromRGB(190,190,212); nameL.BackgroundTransparency=1
			nameL.Font=Enum.Font.SourceSans; nameL.TextSize=12; nameL.TextXAlignment=Enum.TextXAlignment.Left; nameL.ZIndex=33; nameL.Parent=row

			-- Description (small, grey)
			if m.desc then
				local descL=Instance.new("TextLabel"); descL.Size=UDim2.new(1,-180,1,0); descL.Position=UDim2.new(0,178,0,0)
				descL.Text=m.desc; descL.TextColor3=Color3.fromRGB(90,90,120); descL.BackgroundTransparency=1
				descL.Font=Enum.Font.SourceSans; descL.TextSize=10; descL.TextXAlignment=Enum.TextXAlignment.Left
				descL.TextTruncate=Enum.TextTruncate.AtEnd; descL.ZIndex=33; descL.Parent=row
			end

			row.MouseEnter:Connect(function() tweenService:Create(row,TweenInfo.new(0.08),{BackgroundColor3=Color3.fromRGB(34,34,58)}):Play() end)
			row.MouseLeave:Connect(function() tweenService:Create(row,TweenInfo.new(0.08),{BackgroundColor3=isFirst and Color3.fromRGB(28,28,48) or Color3.fromRGB(18,18,30)}):Play() end)

			local ins=m.insert
			local function accept()
				local text=codeBox.Text
				if lastWord~="" then text=text:sub(1,-(#lastWord+1)) end
				codeBox.Text=text..ins; hideSugg(); codeBox:CaptureFocus()
			end
			row.MouseButton1Click:Connect(accept)
		end

		local totalH=#matches*IH
		suggFrame.Size=UDim2.new(1,0,0,totalH)
		suggOuter.Size=UDim2.new(0,CODE_W+GUT_W,0,totalH)
		-- Move suggOuter UP so it appears above the preview (above CODE_H bottom)
		suggOuter.Position=UDim2.new(0,0,0,TB_H+CODE_H-totalH)
		suggFrame.Visible=true
	end

	-- Debounced autocomplete
	local debounce=nil
	codeBox:GetPropertyChangedSignal("Text"):Connect(function()
		if debounce then task.cancel(debounce) end
		debounce=task.delay(0.15,function()
			local word=codeBox.Text:match("[%w%.%:_]+$") or ""; showSugg(word)
		end)
	end)

	-- Enter to accept, Escape to close
	userInput.InputBegan:Connect(function(i,gp)
		if gp then return end
		if i.KeyCode==Enum.KeyCode.Return and suggFrame.Visible then
			for _,c in ipairs(suggFrame:GetChildren()) do
				if c:IsA("TextButton") and c.Position==UDim2.new(0,0,0,0) then
					c.MouseButton1Click:Fire(); break
				end
			end
		end
		if i.KeyCode==Enum.KeyCode.Escape then hideSugg() end
	end)

	-- Toolbar
	local toolbar=Instance.new("Frame"); toolbar.Size=UDim2.new(1,0,0,TOOL_H); toolbar.Position=UDim2.new(0,0,1,-TOOL_H)
	toolbar.BackgroundColor3=Color3.fromRGB(16,16,24); toolbar.BorderSizePixel=0; toolbar.Parent=win
	local tc=Instance.new("UICorner"); tc.CornerRadius=UDim.new(0,8); tc.Parent=toolbar
	local tcFix=Instance.new("Frame"); tcFix.Size=UDim2.new(1,0,0,8)
	tcFix.BackgroundColor3=Color3.fromRGB(16,16,24); tcFix.BorderSizePixel=0; tcFix.Parent=toolbar
	local topL=Instance.new("Frame"); topL.Size=UDim2.new(1,0,0,1); topL.BackgroundColor3=Color3.fromRGB(32,32,45); topL.BorderSizePixel=0; topL.Parent=toolbar

	local statusLbl=Instance.new("TextLabel"); statusLbl.Size=UDim2.new(0,130,1,0); statusLbl.Position=UDim2.new(1,-134,0,0)
	statusLbl.Text="Ready"; statusLbl.TextColor3=Color3.fromRGB(60,60,85); statusLbl.BackgroundTransparency=1
	statusLbl.Font=Enum.Font.SourceSans; statusLbl.TextSize=11; statusLbl.TextXAlignment=Enum.TextXAlignment.Right; statusLbl.ZIndex=6; statusLbl.Parent=toolbar

	local function setStatus(msg,color)
		statusLbl.Text=msg; tweenService:Create(statusLbl,TweenInfo.new(0.12),{TextColor3=color or Color3.fromRGB(60,60,85)}):Play()
	end

	local function mkTBtn(text,bgC,xOff,w)
		local btn=Instance.new("TextButton"); btn.Size=UDim2.new(0,w or 65,0,22); btn.Position=UDim2.new(0,xOff,0.5,-11)
		btn.Text=text; btn.TextColor3=Color3.new(1,1,1); btn.BackgroundColor3=bgC
		btn.Font=Enum.Font.SourceSansBold; btn.TextSize=11; btn.BorderSizePixel=0; btn.ZIndex=6; btn.Parent=toolbar
		local bc=Instance.new("UICorner"); bc.CornerRadius=UDim.new(0,4); bc.Parent=btn
		btn.MouseEnter:Connect(function() tweenService:Create(btn,TweenInfo.new(0.1),{BackgroundColor3=bgC:Lerp(Color3.new(1,1,1),0.12)}):Play() end)
		btn.MouseLeave:Connect(function() tweenService:Create(btn,TweenInfo.new(0.1),{BackgroundColor3=bgC}):Play() end)
		return btn
	end

	local runBtn    =mkTBtn("Run",    Color3.fromRGB(38,162,46),  6,  55)
	local checkBtn  =mkTBtn("Check",  Color3.fromRGB(45,126,215), 65, 58)
	local fmtBtn    =mkTBtn("Format", Color3.fromRGB(80,80,110),  127,60)
	local copyBtn   =mkTBtn("Copy",   Color3.fromRGB(65,65,90),   191,55)
	local saveBtn   =mkTBtn("Save",   Color3.fromRGB(85,58,168),  250,55)
	local clearBtn  =mkTBtn("Clear",  Color3.fromRGB(145,36,36),  309,55)

	runBtn.MouseButton1Click:Connect(function()
		hideSugg()
		local fn,err=loadstring(codeBox.Text)
		if fn then
			task.spawn(fn); setStatus("Running...",Color3.fromRGB(48,195,85)); MyHub:Notify("Code","Executed!",3)
		else
			local e=tostring(err); local errLine=getErrorLine(e)
			updateGutter(errLine); setStatus(e:sub(1,40),Color3.fromRGB(210,50,50)); MyHub:Notify("Syntax Error",e:sub(1,120),6)
		end
	end)

	checkBtn.MouseButton1Click:Connect(function()
		hideSugg()
		local fn,err=loadstring(codeBox.Text)
		if fn then
			updateGutter(nil); setStatus("No errors",Color3.fromRGB(48,195,85)); MyHub:Notify("Check","Code hop le!",4)
		else
			local e=tostring(err); updateGutter(getErrorLine(e))
			setStatus(e:sub(1,40),Color3.fromRGB(210,50,50)); MyHub:Notify("Syntax Error",e:sub(1,120),6)
		end
	end)

	fmtBtn.MouseButton1Click:Connect(function()
		hideSugg(); local formatted=autoIndent(codeBox.Text)
		codeBox.Text=formatted; setStatus("Formatted",Color3.fromRGB(100,160,255))
	end)

	copyBtn.MouseButton1Click:Connect(function()
		if not setclipboard then setStatus("Unavailable",Color3.fromRGB(210,130,50)); return end
		setclipboard(codeBox.Text); setStatus("Copied!",Color3.fromRGB(80,160,255))
	end)

	saveBtn.MouseButton1Click:Connect(function()
		if codeBox.Text:match("^%s*$") then setStatus("Empty!",Color3.fromRGB(210,130,50)); return end
		local name="Code_"..os.date("%m%d_%H%M%S")
		table.insert(scripts,{name=name,code=codeBox.Text,source="editor"}); saveScripts()
		setStatus("Saved: "..name,Color3.fromRGB(150,85,255)); MyHub:Notify("Saved",name,3)
	end)

	clearBtn.MouseButton1Click:Connect(function()
		hideSugg(); codeBox.Text=DEFAULT_CODE; updateGutter(nil); setStatus("Ready",Color3.fromRGB(60,60,85))
	end)

	-- Open animation
	tweenService:Create(win,TweenInfo.new(0.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=UDim2.new(0,WIN_W,0,WIN_H)}):Play()
end

