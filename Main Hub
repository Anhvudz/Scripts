local DEFAULT={theme="Default",oldAnimation=false,oldNotify=false,oldUi=false,betaUi=false,noShadow=false,soundSrc="156286438",soundVol=45}
local cfg=loadJSON(SETTINGS_FILE)
for k,v in pairs(DEFAULT) do if cfg[k]==nil then cfg[k]=v end end
local function saveCfg()
	saveJSON(SETTINGS_FILE,cfg)
	-- Lưu global settings để script khác dùng MyHub cũng nhận luôn
	MyHub.GlobalSettings.theme    = cfg.oldUi and "Classic" or cfg.betaUi and "BetaUI" or cfg.theme
	MyHub.GlobalSettings.noShadow = cfg.noShadow
	MyHub.Settings.oldAnimation   = cfg.oldAnimation
	MyHub.Settings.oldNotify      = cfg.oldNotify
	MyHub:SaveGlobalSettings()
end

local scripts     = loadJSON(SCRIPTS_FILE)
