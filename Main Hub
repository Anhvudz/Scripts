			local badge=Instance.new("TextLabel"); badge.Size=UDim2.new(0,80,1,0); badge.Position=UDim2.new(0,6,0,0)
			badge.Text=m.trigger; badge.TextColor3=Color3.fromRGB(100,175,255); badge.BackgroundTransparency=1
