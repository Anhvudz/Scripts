	local function hideSugg() suggFrame.Visible=false end

	local function showSugg(word)
		lastWord=word
		if #word<2 then hideSugg(); return end
		local matches={}
		for _,s in ipairs(allSnippets) do
			local t=s.trigger
			if t:sub(1,#word)==word or (#word>=#t and word:sub(1,#t)==t) then
				table.insert(matches,s); if #matches>=7 then break end
			end
		end
		if #matches==0 then hideSugg(); return end

		for _,c in ipairs(suggFrame:GetChildren()) do if c:IsA("TextButton") or c:IsA("Frame") then c:Destroy() end end

