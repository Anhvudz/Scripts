local function loadJSON(f)
	if not isfile(f) then return {} end
	local ok,d=pcall(httpService.JSONDecode,httpService,readfile(f))
	return (ok and type(d)=="table") and d or {}
end
local function saveJSON(f,d) pcall(writefile,f,httpService:JSONEncode(d)) end

local SETTINGS_FILE = "PotassiumHub/settings.json"
local SCRIPTS_FILE  = "PotassiumHub/scripts.json"
