local editorOpen = false

local function openCodeEditor(preload)
	if editorOpen then return end
	editorOpen = true

	-- Gộp built-in + user snippets.
	local allSnippets = {}
	for _,s in ipairs(BASE_SNIPPETS) do table.insert(allSnippets,s) end
	for _,s in ipairs(userSnippets) do table.insert(allSnippets,s) end

	local edGui=Instance.new("ScreenGui"); edGui.Name="PotassiumEditor"
	edGui.ResetOnSpawn=false; edGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling; edGui.Parent=exploitGui

	-- Mobile-friendly size (nhỏ hơn, có thể drag).
