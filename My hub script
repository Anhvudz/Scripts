local function safeMakeFolder(p)
	if hasFileIO and typeof(isfolder) == "function" and not isfolder(p) then pcall(makefolder, p) end
end

local function safeWriteFile(f, d)
	if not hasFileIO then return end
	pcall(writefile, f, httpService:JSONEncode(d))
end

local function safeReadFile(f)
	if not hasFileIO or typeof(isfile) ~= "function" or not isfile(f) then return nil end
	local ok, raw = pcall(readfile, f)
	if not ok then return nil end
	local ok2, dec = pcall(httpService.JSONDecode, httpService, raw)
	return ok2 and dec or nil
end

