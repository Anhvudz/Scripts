					end
				end)

				clearBtn.MouseButton1Click:Connect(function()
					remoteLogs = {}; totalCalls = 0
					statusLbl.Text = "Status: " .. (logging and "🔴 Recording" or "Inactive") .. " | Total: 0"
					updateDisplay(); MyHub:Notify("Logger", "Logs cleared", 2)
				end)

				saveBtn.MouseButton1Click:Connect(function()
					if #remoteLogs == 0 then MyHub:Notify("Logger", "No logs to save", 2); return end
					if hasFileIO then
