						MyHub:Notify(ok2 and "Saved" or "Error", ok2 and (#remoteLogs .. " entries saved") or tostring(err), 3)
					else
						MyHub:Notify("Error", "File I/O not available", 2)
					end
				end)

				return {
					Clear   = function() remoteLogs = {}; totalCalls = 0; updateDisplay() end,
					GetLogs = function() return remoteLogs end
				}
			end

			-- Mini Explorer: browse all instances with filters and selection callback.
			function SectionApi:NewMiniExplorer(cfg)
				local root        = cfg.Root or game
				local callback    = cfg.Callback or function() end
				local height      = cfg.Height or 220
				local showClasses = cfg.ShowClasses

				local f = makeEl(height)

				local titleLbl = Instance.new("TextLabel"); titleLbl.Size = UDim2.new(0.45, 0, 0, 22); titleLbl.Position = UDim2.new(0, 12, 0, 4)
				titleLbl.Text = "🔍  Explorer"; titleLbl.TextColor3 = currentTheme.TextColor
				titleLbl.BackgroundTransparency = 1; titleLbl.Font = Enum.Font.SourceSansBold; titleLbl.TextSize = 13
				titleLbl.TextXAlignment = Enum.TextXAlignment.Left; titleLbl.Parent = f

				-- Filter type toggle buttons.
				local filterTypes       = { "Name~", "Name=", "Class~" }
				local currentFilterType = "Name~"
				local filterBtns        = {}

				for i, ft in ipairs(filterTypes) do
					local fb = Instance.new("TextButton")
					fb.Size = UDim2.new(0, 46, 0, 18); fb.Position = UDim2.new(0.45, (i - 1) * 50, 0, 7)
					fb.Text = ft; fb.Font = Enum.Font.SourceSans; fb.TextSize = 10; fb.BorderSizePixel = 0
					fb.BackgroundColor3 = ft == currentFilterType and currentTheme.AccentColor or currentTheme.InputBackground
					fb.TextColor3       = ft == currentFilterType and Color3.new(1, 1, 1) or currentTheme.SubTextColor
					fb.Parent = f; addButtonEffects(fb); corner(fb, 3)
					filterBtns[ft] = fb
				end

				-- Filter text input.
				local filterInput = makeInputBox(f, {
					Size = UDim2.new(1, -20, 0, 22), Position = UDim2.new(0, 10, 0, 30),
					Placeholder = "Filter instances...", TextSize = 12
				})

				-- Instance list.
				local listFrame = Instance.new("ScrollingFrame")
				listFrame.Size = UDim2.new(1, -10, 1, -58); listFrame.Position = UDim2.new(0, 5, 0, 57)
				listFrame.BackgroundTransparency = 1; listFrame.ScrollBarThickness = 3
				listFrame.ScrollBarImageColor3 = currentTheme.AccentDim; listFrame.BorderSizePixel = 0; listFrame.Parent = f

				local selectedBtn      = nil
				local selectedInstance = nil

				local function populate()
					listFrame:ClearAllChildren(); local yPos = 0
					local filterText = filterInput.Text
					local ok, descs = pcall(function() return root:GetDescendants() end)
					if not ok then return end

					for _, ins in ipairs(descs) do
						local show = true
						if filterText ~= "" then
							if currentFilterType == "Name~" then
								show = ins.Name:lower():find(filterText:lower(), 1, true) ~= nil
							elseif currentFilterType == "Name=" then
								show = ins.Name == filterText
							elseif currentFilterType == "Class~" then
								show = ins.ClassName:lower():find(filterText:lower(), 1, true) ~= nil
							end
						end
						if showClasses and show then
							local classOk = false
							for _, c in ipairs(showClasses) do
								if pcall(function() return ins:IsA(c) end) and ins:IsA(c) then classOk = true; break end
							end
							show = classOk
						end

						if show then
							local rowBtn = Instance.new("TextButton")
							rowBtn.Size             = UDim2.new(1, 0, 0, 22); rowBtn.Position = UDim2.new(0, 0, 0, yPos)
							rowBtn.Text             = "  [" .. ins.ClassName .. "] " .. ins.Name
							rowBtn.TextColor3       = ins == selectedInstance and Color3.new(1, 1, 1) or currentTheme.SubTextColor
							rowBtn.BackgroundColor3 = ins == selectedInstance and currentTheme.AccentColor or currentTheme.DropdownItem
							rowBtn.Font             = Enum.Font.SourceSans; rowBtn.TextSize = 11
							rowBtn.TextXAlignment   = Enum.TextXAlignment.Left
							rowBtn.BorderSizePixel  = 0; rowBtn.ClipsDescendants = true; rowBtn.Parent = listFrame
							corner(rowBtn, 3)

							local insRef = ins
							rowBtn.MouseButton1Click:Connect(function()
								if selectedBtn then selectedBtn.BackgroundColor3 = currentTheme.DropdownItem; selectedBtn.TextColor3 = currentTheme.SubTextColor end
								selectedBtn = rowBtn; selectedInstance = insRef
								rowBtn.BackgroundColor3 = currentTheme.AccentColor; rowBtn.TextColor3 = Color3.new(1, 1, 1)
								pcall(callback, insRef)
							end)
							yPos = yPos + 24
						end
					end
					listFrame.CanvasSize = UDim2.new(0, 0, 0, yPos)
				end

				for ft, fb in pairs(filterBtns) do
					fb.MouseButton1Click:Connect(function()
						currentFilterType = ft
						for t, b in pairs(filterBtns) do
							b.BackgroundColor3 = t == ft and currentTheme.AccentColor or currentTheme.InputBackground
							b.TextColor3       = t == ft and Color3.new(1, 1, 1) or currentTheme.SubTextColor
						end
						populate()
					end)
				end

				filterInput:GetPropertyChangedSignal("Text"):Connect(populate)
				populate()

				return {
					GetSelected = function() return selectedInstance end,
					Refresh     = populate,
					SetRoot     = function(_, r) root = r; populate() end
				}
			end

