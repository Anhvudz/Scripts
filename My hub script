						startBtn.Text = "▶ Start"
						startBtn.BackgroundColor3 = Color3.fromRGB(50, 170, 80)
						statusLbl.Text = "Status: Inactive | Total: " .. totalCalls
						statusLbl.TextColor3 = Color3.fromRGB(130, 130, 130)

						if logHandler then logHandler.active = false; logHandler = nil end
						MyHub:Notify("Logger", "Recording stopped", 2)
					end
				end)

				clearBtn.MouseButton1Click:Connect(function()
					remoteLogs = {}
					totalCalls = 0
					statusLbl.Text = "Status: " .. (logging and "🔴 Recording" or "Inactive") .. " | Total: 0"
					updateDisplay()
					MyHub:Notify("Logger", "Logs cleared", 2)
				end)

				saveBtn.MouseButton1Click:Connect(function()
					if #remoteLogs == 0 then
						MyHub:Notify("Logger", "No logs to save", 2)
						return
					end
					if hasFileIO then
						local ok2, err = pcall(writefile, "RemoteLog_" .. os.date("%Y%m%d_%H%M%S") .. ".json", httpService:JSONEncode(remoteLogs))
						if ok2 then
							MyHub:Notify("Saved", #remoteLogs .. " entries saved", 3)
						else
							MyHub:Notify("Error", tostring(err), 3)
						end
					else
						MyHub:Notify("Error", "File I/O not available", 2)
					end
				end)

				tab.yPos = tab.yPos + 258
				updateCanvas()

				return {
					Clear = function()
						remoteLogs = {}
						totalCalls = 0
						updateDisplay()
					end,
					GetLogs = function() return remoteLogs end
				}
			end

			return SectionApi
		end

		return TabApi
	end

	function WindowApi:SetTheme(themeName)
		currentTheme = Themes[tostring(themeName)] or Themes.Default
		if mainWindow then mainWindow.BackgroundColor3 = currentTheme.Background end
		if titleBar then titleBar.BackgroundColor3 = currentTheme.Topbar end
	end

	function WindowApi:AddTheme(name, themeTable)
		Themes[tostring(name)] = themeTable
	end

	function WindowApi:Destroy()
		safeWriteFile(configFile, configData)
		screenGui:Destroy()
	end

	return WindowApi
end

return MyHub
