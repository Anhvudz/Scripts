						pcall(callback, false)
						MyHub:Notify("Hook Disabled", remoteName, 2)
					end
				end)

				logBtn.MouseButton1Click:Connect(function()
					if #callLog == 0 then
						MyHub:Notify("Log", "No calls recorded yet", 2)
						return
					end
					local out = ""
					for i = 1, math.min(5, #callLog) do
						out = out .. callLog[i].Time .. ": " .. callLog[i].Original .. " → " .. callLog[i].Forced .. "\n"
					end
					MyHub:Notify("Recent Calls (" .. remoteName .. ")", out, 5)
				end)

				tab.yPos = tab.yPos + 100
				updateCanvas()

				return {
					SetValue = function(_, value) valueInput.Text = tostring(value) end,
					GetCallCount = function() return callCount end,
					GetLog = function() return callLog end
				}
			end

