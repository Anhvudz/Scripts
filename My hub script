local function safeMakeFolder(folder)
	if hasFileIO and typeof(isfolder) == "function" and not isfolder(folder) then
		makefolder(folder)
	end
end

local function safeWriteFile(file, data)
	if not hasFileIO then return end
	pcall(writefile, file, httpService:JSONEncode(data))
end

local function safeReadFile(file)
	if not hasFileIO or typeof(isfile) ~= "function" or not isfile(file) then return nil end
	local readOk, raw = pcall(readfile, file)
	if not readOk then return nil end
	local decodeOk, decoded = pcall(httpService.JSONDecode, httpService, raw)
	return decodeOk and decoded or nil
end

