		btn.TextSize         = 12
		btn.BorderSizePixel  = 0
		btn.ZIndex           = sf.ZIndex + 1
		btn.Parent           = sf
		corner(btn, 4)
		addButtonEffects(btn)
		btn.MouseButton1Click:Connect(function() pcall(cfg.Callback or function() end) end)
