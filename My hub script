								local original = args[1]
								args[1] = forceValue
								statusLbl.Text = "Status: ✅ Active | Calls: " .. callCount
								statusLbl.TextColor3 = Color3.fromRGB(76, 175, 80)
								table.insert(callLog, 1, {
									Time = os.date("%H:%M:%S"),
									Original = tostring(original),
									Forced = tostring(forceValue)
								})
								if #callLog > 25 then table.remove(callLog) end
							end
						end)

						pcall(callback, true, forceValue)
						MyHub:Notify("Hook Active", remoteName .. " → " .. tostring(forceValue), 2)
					else
