					local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, -20, 0, 22); lbl.Position = UDim2.new(0, 10, 0, 4)
					lbl.Text = name; lbl.TextColor3 = currentTheme.TextColor; lbl.BackgroundTransparency = 1
					lbl.Font = Enum.Font.SourceSans; lbl.TextSize = 13; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = f
					yOff = 28
				end

				local btn = Instance.new("ImageButton")
				btn.Size = UDim2.new(1, -10, 0, height); btn.Position = UDim2.new(0, 5, 0, yOff)
				btn.BackgroundTransparency = 1; btn.ScaleType = scaleType; btn.BorderSizePixel = 0; btn.Parent = f
				corner(btn, 4)

				if filePath and typeof(getcustomasset) == "function" then
					local ok, asset = pcall(getcustomasset, filePath); if ok then btn.Image = asset end
				elseif imageId then
					btn.Image = "rbxassetid://" .. tostring(imageId)
				end

				btn.MouseButton1Click:Connect(function() clickSound:Play(); pcall(callback) end)
				btn.MouseEnter:Connect(function() tweenService:Create(btn, TweenInfo.new(0.12), { ImageTransparency = 0.18 }):Play() end)
				btn.MouseLeave:Connect(function() tweenService:Create(btn, TweenInfo.new(0.12), { ImageTransparency = 0 }):Play() end)

				return {
					SetImage = function(_, id, isFile)
						if isFile and typeof(getcustomasset) == "function" then
							local ok, asset = pcall(getcustomasset, id); if ok then btn.Image = asset end
						else
							btn.Image = "rbxassetid://" .. tostring(id)
						end
					end
				}
			end

			-- ViewportFrame for rendering instances.
			function SectionApi:NewViewportFrame(cfg)
				local name      = cfg.Name or ""
				local vpInst    = cfg.Instance
				local height    = cfg.Height or 120
				local ambient   = cfg.Ambient or Color3.fromRGB(175, 175, 175)
				local lightDir  = cfg.LightDirection or Vector3.new(-1, -2, -1)
				local totalH    = height + (name ~= "" and 28 or 0)
				local f         = makeEl(totalH)

				local yOff = 0
				if name ~= "" then
					local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, -20, 0, 22); lbl.Position = UDim2.new(0, 10, 0, 4)
					lbl.Text = name; lbl.TextColor3 = currentTheme.TextColor; lbl.BackgroundTransparency = 1
					lbl.Font = Enum.Font.SourceSans; lbl.TextSize = 13; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = f
					yOff = 28
				end

				local vf = Instance.new("ViewportFrame")
				vf.Size = UDim2.new(1, -10, 0, height); vf.Position = UDim2.new(0, 5, 0, yOff)
				vf.BackgroundColor3 = Color3.fromRGB(10, 10, 10); vf.BorderSizePixel = 0
				vf.Ambient = ambient; vf.LightDirection = lightDir; vf.Parent = f
				corner(vf, 5); stroke(vf, currentTheme.Divider, 1)

				local cam = Instance.new("Camera"); cam.Parent = vf; vf.CurrentCamera = cam
				local displayClone = nil

				local function setInstance(ins)
					if displayClone then displayClone:Destroy(); displayClone = nil end
					if not ins then return end
					local ok, clone = pcall(function() return ins:Clone() end)
					if not ok then return end
					clone.Parent = vf; displayClone = clone
					local ok2, cf, size = pcall(function() return clone:GetBoundingBox() end)
					if ok2 then
						local maxD = math.max(size.X, size.Y, size.Z)
						cam.CFrame = CFrame.new(cf.Position + Vector3.new(maxD * 1.5, maxD * 0.6, maxD * 1.5), cf.Position)
					end
				end

				if vpInst then setInstance(vpInst) end

				return {
					SetInstance      = setInstance,
					GetCamera        = function() return cam end,
					GetViewportFrame = function() return vf end
				}
			end

			return SectionApi
		end -- NewSection

		return TabApi
	end -- NewTab

	function WindowApi:SetTheme(themeName)
		currentTheme = Themes[tostring(themeName)] or Themes.Default
		if mainWindow then mainWindow.BackgroundColor3 = currentTheme.Background end
		if titleBar   then titleBar.BackgroundColor3   = currentTheme.Topbar end
	end

	function WindowApi:AddTheme(name, themeTable)
		Themes[tostring(name)] = themeTable
	end

	function WindowApi:Destroy()
		safeWriteFile(configFile, configData)
		screenGui:Destroy()
	end

	return WindowApi
end -- CreateWindow

return MyHub
