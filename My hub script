		img.Image = "rbxassetid://" .. tostring(imageId); img.BackgroundTransparency = 1; img.Parent = notif
	end

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size              = UDim2.new(1, -xOff - 8, 0, 26)
	titleLbl.Position          = UDim2.new(0, xOff, 0, 8)
	titleLbl.Text              = title
	titleLbl.TextColor3        = currentTheme.TextColor
	titleLbl.BackgroundTransparency = 1
	titleLbl.Font              = Enum.Font.SourceSansBold
	titleLbl.TextSize          = 14
	titleLbl.TextXAlignment    = Enum.TextXAlignment.Left
	titleLbl.Parent            = notif

	local textLbl = Instance.new("TextLabel")
	textLbl.Size              = UDim2.new(1, -xOff - 8, 0, 36)
	textLbl.Position          = UDim2.new(0, xOff, 0, 34)
	textLbl.Text              = text
	textLbl.TextColor3        = currentTheme.SubTextColor
	textLbl.BackgroundTransparency = 1
	textLbl.Font              = Enum.Font.SourceSans
	textLbl.TextSize          = 12
	textLbl.TextWrapped       = true
	textLbl.TextXAlignment    = Enum.TextXAlignment.Left
	textLbl.TextYAlignment    = Enum.TextYAlignment.Top
	textLbl.Parent            = notif

	-- Close button.
	local closeX = Instance.new("TextButton")
	closeX.Size               = UDim2.new(0, 18, 0, 18)
	closeX.Position           = UDim2.new(1, -22, 0, 6)
	closeX.Text               = "✕"
	closeX.TextColor3         = currentTheme.SectionLabel
	closeX.BackgroundTransparency = 1
	closeX.Font               = Enum.Font.SourceSans
	closeX.TextSize           = 12
	closeX.Parent             = notif

	local nd = {
		alive      = true,
		frame      = notif,
		gui        = gui,
		textLabel  = textLbl,
		timerBar   = timerBar,
		timerTween = nil,
		dismissAt  = tick() + duration
	}
	table.insert(notifStack, nd)
	activeNotifsByTitle[title] = nd
	reorderNotifStack()

	local tt = tweenService:Create(timerBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = UDim2.new(0, 0, 0, 2)
	})
	tt:Play(); nd.timerTween = tt

	local function dismiss()
		if not nd.alive then return end
		nd.alive = false
		activeNotifsByTitle[title] = nil
		tweenService:Create(notif, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(1, NOTIF_W + NOTIF_PAD_R, 0, notif.Position.Y.Offset)
		}):Play()
		task.wait(0.32)
		gui:Destroy()
		reorderNotifStack()
	end

	closeX.MouseButton1Click:Connect(dismiss)

	task.spawn(function()
		repeat task.wait(0.05) until tick() >= nd.dismissAt or not nd.alive
		dismiss()
	end)
end

-- UICorner helper.
local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 4)
	c.Parent = parent
	return c
end

-- UIStroke helper.
local function stroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(60, 60, 60)
	s.Thickness = thickness or 1
	s.Parent = parent
	return s
end

-- Button hover + ripple effects.
local function addButtonEffects(btn, noRipple)
	btn.ClipsDescendants = true
	local savedColor     = btn.BackgroundColor3

	if not noRipple then
		btn.MouseButton1Down:Connect(function()
			clickSound:Play()
			local mouse  = localPlayer:GetMouse()
			local mouseX = mouse.X - btn.AbsolutePosition.X
			local mouseY = mouse.Y - btn.AbsolutePosition.Y
			local ripple = Instance.new("Frame")
			ripple.Size               = UDim2.new(0, 0, 0, 0)
			ripple.Position           = UDim2.new(0, mouseX, 0, mouseY)
			ripple.AnchorPoint        = Vector2.new(0.5, 0.5)
			ripple.BackgroundColor3   = Color3.new(1, 1, 1)
			ripple.BackgroundTransparency = 0.6
			ripple.BorderSizePixel    = 0
			ripple.ZIndex             = btn.ZIndex + 2
			ripple.Parent             = btn
			corner(ripple, 999)
			local rs = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2
			tweenService:Create(ripple, TweenInfo.new(0.48, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, rs, 0, rs), BackgroundTransparency = 1
			}):Play()
			debrisService:AddItem(ripple, 0.5)
		end)
	end

	btn.MouseEnter:Connect(function()
		savedColor = btn.BackgroundColor3
		tweenService:Create(btn, TweenInfo.new(0.12), {
			BackgroundColor3 = savedColor:Lerp(Color3.new(1, 1, 1), 0.08)
		}):Play()
	end)

	btn.MouseLeave:Connect(function()
		tweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = savedColor }):Play()
	end)
end

-- Draggable frame.
local function makeDraggable(dragFrame, targetFrame)
	local dragging = false; local sx, sy, sp; local mc, rc

	local function stopDrag()
		if not dragging then return end
		dragging = false
		if mc then mc:Disconnect(); mc = nil end
		if rc then rc:Disconnect(); rc = nil end
	end

	dragFrame.InputBegan:Connect(function(input)
		if dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		dragging = true
		sx = input.Position.X; sy = input.Position.Y
		sp = {
			X = { Scale = targetFrame.Position.X.Scale, Offset = targetFrame.Position.X.Offset },
			Y = { Scale = targetFrame.Position.Y.Scale, Offset = targetFrame.Position.Y.Offset }
		}
		mc = userInputService.InputChanged:Connect(function(ic)
			if not dragging then return end
			if ic.UserInputType ~= Enum.UserInputType.MouseMovement and ic.UserInputType ~= Enum.UserInputType.Touch then return end
			targetFrame.Position = UDim2.new(sp.X.Scale, sp.X.Offset + ic.Position.X - sx, sp.Y.Scale, sp.Y.Offset + ic.Position.Y - sy)
		end)
		rc = userInputService.InputEnded:Connect(function(ie)
			if ie.UserInputType == Enum.UserInputType.MouseButton1 or ie.UserInputType == Enum.UserInputType.Touch then stopDrag() end
		end)
	end)
end

-- Generic slider drag logic.
local function makeSliderDraggable(bar, fill, knob, minV, maxV, valLbl, configKey, callback, decimals)
	local dragging = false; local mc, rc

	local function formatVal(v)
		if decimals and decimals > 0 then
			return tostring(math.floor(v * 10^decimals + 0.5) / 10^decimals)
		end
		return tostring(math.floor(v))
	end

	local function update(input)
		local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local val = minV + (maxV - minV) * rel
		fill.Size        = UDim2.new(rel, 0, 1, 0)
		knob.Position    = UDim2.new(rel, -8, 0.5, -8)
		valLbl.Text      = formatVal(val)
		if configKey then configData.sliders[configKey] = val; safeWriteFile(configFile, configData) end
		if callback then pcall(callback, val) end
	end

	local function stopDrag()
		if not dragging then return end
		dragging = false
		if mc then mc:Disconnect(); mc = nil end
		if rc then rc:Disconnect(); rc = nil end
	end

	local function startDrag(input)
		if dragging then return end
		dragging = true; update(input)
		mc = userInputService.InputChanged:Connect(function(ic)
			if dragging and (ic.UserInputType == Enum.UserInputType.MouseMovement or ic.UserInputType == Enum.UserInputType.Touch) then update(ic) end
		end)
		rc = userInputService.InputEnded:Connect(function(ie)
			if ie.UserInputType == Enum.UserInputType.MouseButton1 or ie.UserInputType == Enum.UserInputType.Touch then stopDrag() end
		end)
	end

	bar.InputBegan:Connect(function(i)  if i.UserInputType == Enum.UserInputType.MouseButton1 then startDrag(i) end end)
	knob.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then startDrag(i) end end)
end

-- Input box with active stroke highlight.
local function makeInputBox(parent, cfg)
