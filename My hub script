						toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 170, 80)
						statusLbl.Text = "Status: Inactive | Calls: " .. callCount
						statusLbl.TextColor3 = Color3.fromRGB(130, 130, 130)

