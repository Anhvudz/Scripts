	local nnc = Instance.new("UICorner"); nnc.CornerRadius = UDim.new(0, 8); nnc.Parent = notif
	local nns = Instance.new("UIStroke")
	nns.Color = currentTheme.Divider; nns.Thickness = 1; nns.Parent = notif

	-- Accent side bar.
