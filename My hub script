							if not dragging then return end
							local rel = math.clamp((input.Position.X - sbg.AbsolutePosition.X) / sbg.AbsoluteSize.X, 0, 1)
							local val = math.floor(rel * 255)
							setValue(val)
							sfill.Size = UDim2.new(rel, 0, 1, 0)
							sknob.Position = UDim2.new(rel, -7, 0.5, -7)
							slbl.Text = channel .. ": " .. val
