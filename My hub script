	box.Size              = cfg.Size or UDim2.new(1, -16, 0, 22)
	box.Position          = cfg.Position or UDim2.new(0, 8, 0, 0)
	box.Text              = cfg.Text or ""
	box.PlaceholderText   = cfg.Placeholder or "..."
	box.TextColor3        = currentTheme.TextColor
	box.PlaceholderColor3 = currentTheme.PlaceholderColor
	box.BackgroundColor3  = currentTheme.InputBackground
	box.BorderSizePixel   = 0
	box.Font              = Enum.Font.SourceSans
	box.TextSize          = cfg.TextSize or 13
	box.TextXAlignment    = Enum.TextXAlignment.Left
	box.ClearTextOnFocus  = false
	box.Parent            = parent
	corner(box, 4)
	local s = stroke(box, currentTheme.InputStroke, 1)
	box.Focused:Connect(function()
		tweenService:Create(s, TweenInfo.new(0.15), { Color = currentTheme.InputStrokeActive }):Play()
	end)
	box.FocusLost:Connect(function()
		tweenService:Create(s, TweenInfo.new(0.15), { Color = currentTheme.InputStroke }):Play()
	end)
	return box
end

