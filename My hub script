-- Centralized __namecall hook dispatcher.
local namecallHandlers = {}
local originalNamecall = nil

local function installNamecallHook()
	if originalNamecall then return end
	originalNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		if checkcaller() then return originalNamecall(self, ...) end
		local method = getnamecallmethod()
		local args = { ... }
		for _, handler in ipairs(namecallHandlers) do
			if handler.active then
				handler.fn(self, method, args)
			end
		end
		return originalNamecall(self, table.unpack(args))
	end))
end

local function registerNamecallHandler(fn)
	local handler = { fn = fn, active = true }
	table.insert(namecallHandlers, handler)
	installNamecallHook()
	return handler
end

-- Button hover + ripple effects.
local function addButtonEffects(btn)
	btn.ClipsDescendants = true
	local baseColor = btn.BackgroundColor3

	btn.MouseButton1Down:Connect(function()
		clickSound:Play()
		local mouse = localPlayer:GetMouse()
		local mouseX = mouse.X - btn.AbsolutePosition.X
		local mouseY = mouse.Y - btn.AbsolutePosition.Y

		local ripple = Instance.new("Frame")
		ripple.Size = UDim2.new(0, 0, 0, 0)
		ripple.Position = UDim2.new(0, mouseX, 0, mouseY)
		ripple.AnchorPoint = Vector2.new(0.5, 0.5)
		ripple.BackgroundColor3 = Color3.new(1, 1, 1)
		ripple.BackgroundTransparency = 0.55
		ripple.BorderSizePixel = 0
		ripple.ZIndex = btn.ZIndex + 1
		ripple.Parent = btn

		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(1, 0)
		rc.Parent = ripple

		local rippleSize = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2
		tweenService:Create(ripple, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, rippleSize, 0, rippleSize),
			BackgroundTransparency = 1
		}):Play()
		debrisService:AddItem(ripple, 0.6)

		for i = 1, 6 do
			local p = Instance.new("Frame")
			p.Size = UDim2.new(0, 5, 0, 5)
			p.Position = UDim2.new(0, mouseX, 0, mouseY)
			p.AnchorPoint = Vector2.new(0.5, 0.5)
			p.BackgroundColor3 = Color3.fromRGB(math.random(100, 255), math.random(100, 255), math.random(100, 255))
			p.BorderSizePixel = 0
			p.ZIndex = btn.ZIndex + 2
			p.Parent = btn
			local pc = Instance.new("UICorner")
			pc.CornerRadius = UDim.new(1, 0)
			pc.Parent = p
			local angle = (i / 6) * math.pi * 2
			local dist = math.random(25, 50)
			tweenService:Create(p, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(0, mouseX + math.cos(angle) * dist, 0, mouseY + math.sin(angle) * dist),
				Size = UDim2.new(0, 0, 0, 0),
				BackgroundTransparency = 1
			}):Play()
			debrisService:AddItem(p, 0.5)
		end
	end)

	btn.MouseEnter:Connect(function()
		baseColor = btn.BackgroundColor3
		tweenService:Create(btn, TweenInfo.new(0.15), {
			BackgroundColor3 = btn.BackgroundColor3:Lerp(Color3.new(1, 1, 1), 0.1)
		}):Play()
	end)

	btn.MouseLeave:Connect(function()
		tweenService:Create(btn, TweenInfo.new(0.15), {
			BackgroundColor3 = baseColor
		}):Play()
	end)
end

-- Draggable frame.
local function makeDraggable(dragFrame, targetFrame)
	local dragging = false
	local dragStartX, dragStartY = 0, 0
	local startPos
	local moveConn, releaseConn

	local function stopDrag()
		if not dragging then return end
		dragging = false
		if moveConn then moveConn:Disconnect(); moveConn = nil end
		if releaseConn then releaseConn:Disconnect(); releaseConn = nil end
	end

	dragFrame.InputBegan:Connect(function(input)
		if dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		dragging = true
		dragStartX = input.Position.X
		dragStartY = input.Position.Y
		startPos = {
			X = { Scale = targetFrame.Position.X.Scale, Offset = targetFrame.Position.X.Offset },
			Y = { Scale = targetFrame.Position.Y.Scale, Offset = targetFrame.Position.Y.Offset }
		}
		moveConn = userInputService.InputChanged:Connect(function(ic)
			if not dragging then return end
			if ic.UserInputType ~= Enum.UserInputType.MouseMovement and ic.UserInputType ~= Enum.UserInputType.Touch then return end
			targetFrame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + ic.Position.X - dragStartX,
				startPos.Y.Scale, startPos.Y.Offset + ic.Position.Y - dragStartY
			)
		end)
		releaseConn = userInputService.InputEnded:Connect(function(ie)
			if ie.UserInputType == Enum.UserInputType.MouseButton1 or ie.UserInputType == Enum.UserInputType.Touch then
				stopDrag()
			end
		end)
	end)
end

-- Slider drag logic.
local function makeSliderDraggable(sliderBar, fillBar, knob, min, max, valueLabel, configKey, callback)
	local dragging = false
	local moveConn, releaseConn

	local function update(input)
		if not dragging then return end
		local relative = math.clamp((input.Position.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
		local value = min + (max - min) * relative
		fillBar.Size = UDim2.new(relative, 0, 1, 0)
		knob.Position = UDim2.new(relative, -8, 0.5, -8)
		valueLabel.Text = tostring(math.floor(value))
		if configKey then configData.sliders[configKey] = value; safeWriteFile(configFile, configData) end
		if callback then pcall(callback, value) end
	end

	local function stopDrag()
		if not dragging then return end
		dragging = false
		if moveConn then moveConn:Disconnect(); moveConn = nil end
		if releaseConn then releaseConn:Disconnect(); releaseConn = nil end
	end

	knob.InputBegan:Connect(function(input)
		if dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		dragging = true
		moveConn = userInputService.InputChanged:Connect(function(ic)
			if not dragging then return end
			if ic.UserInputType == Enum.UserInputType.MouseMovement or ic.UserInputType == Enum.UserInputType.Touch then
				update(ic)
			end
		end)
		releaseConn = userInputService.InputEnded:Connect(function(ie)
			if ie.UserInputType == Enum.UserInputType.MouseButton1 or ie.UserInputType == Enum.UserInputType.Touch then
				stopDrag()
			end
		end)
	end)

	sliderBar.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
		dragging = true
		update(input)
		moveConn = userInputService.InputChanged:Connect(function(ic)
			if not dragging then return end
			if ic.UserInputType == Enum.UserInputType.MouseMovement then update(ic) end
		end)
		releaseConn = userInputService.InputEnded:Connect(function(ie)
			if ie.UserInputType == Enum.UserInputType.MouseButton1 then stopDrag() end
		end)
	end)
end

