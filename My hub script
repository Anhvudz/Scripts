-- Centralized __namecall dispatcher.
local namecallHandlers = {}
local originalNamecall = nil

local function installNamecallHook()
	if originalNamecall then return end
	originalNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		if checkcaller() then return originalNamecall(self, ...) end
		local method = getnamecallmethod()
		local args   = { ... }
		for _, h in ipairs(namecallHandlers) do
			if h.active then pcall(h.fn, self, method, args) end
		end
		return originalNamecall(self, table.unpack(args))
	end))
end

local function registerNamecallHandler(fn)
	local h = { fn = fn, active = true }
	table.insert(namecallHandlers, h)
	installNamecallHook()
	return h
end

-- Notification stack + deduplication.
MyHub.NotificationHistory = {}
local activeNotifsByTitle = {}
local notifStack          = {}

local function reorderNotifStack()
	local live = {}
	for _, n in ipairs(notifStack) do if n.alive then table.insert(live, n) end end
	notifStack = live
	for i, n in ipairs(notifStack) do
		local targetY = NOTIF_PAD_T + (i - 1) * (NOTIF_H + NOTIF_GAP)
		tweenService:Create(n.frame, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {
			Position = UDim2.new(1, -(NOTIF_W + NOTIF_PAD_R), 0, targetY)
		}):Play()
	end
end

function MyHub:Notify(title, text, duration, imageId)
	title    = tostring(title)
	text     = tostring(text)
	duration = duration or 5

	table.insert(MyHub.NotificationHistory, 1, { title = title, text = text, time = os.date("%H:%M:%S") })
	if #MyHub.NotificationHistory > 50 then table.remove(MyHub.NotificationHistory) end

	-- Update existing same-title notification.
	local ex = activeNotifsByTitle[title]
	if ex and ex.alive then
		ex.textLabel.Text = text
		ex.dismissAt      = tick() + duration
		ex.timerBar.Size  = UDim2.new(1, 0, 0, 3)
		if ex.timerTween then ex.timerTween:Cancel() end
		ex.timerTween = tweenService:Create(ex.timerBar,
			TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 3) })
		ex.timerTween:Play()
		return
	end

	-- Build notification UI.
	local gui = Instance.new("ScreenGui")
	gui.Name = "MyHubNotif"; gui.ResetOnSpawn = false; gui.Parent = exploitGui

	local notif = Instance.new("Frame")
