-- =====================
-- UTILITY
-- =====================

local function addCleanup(c)
	table.insert(maidConns, c)
end

local function cleanup()
	for _, c in pairs(maidConns) do
		if typeof(c) == "RBXScriptConnection" then pcall(function() c:Disconnect() end)
		elseif typeof(c) == "Instance" then pcall(function() c:Destroy() end) end
	end
	maidConns = {}
end

local function el(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do pcall(function() inst[k] = v end) end
	if parent then inst.Parent = parent end
	return inst
end

local function tw(inst, props, t)
	tweenService:Create(inst, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad), props):Play()
end

local function corner(r, p) return el("UICorner", {CornerRadius = UDim.new(0,r)}, p) end
local function stroke(col, thk, p) return el("UIStroke", {Color=col, Thickness=thk}, p) end

-- =====================
-- DRAG / RESIZE (for frame widgets)
-- =====================

local function makeDraggable(frame, handle)
	handle = handle or frame
	local dragging, dStart, sPos = false, nil, nil
	local c1 = handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dStart = i.Position; sPos = frame.Position
		end
	end)
	local c2 = userInputService.InputChanged:Connect(function(i)
		if not dragging then return end
		if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
		local d = i.Position - dStart
		frame.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset+d.X, sPos.Y.Scale, sPos.Y.Offset+d.Y)
	end)
	local c3 = userInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging=false end
	end)
	addCleanup(c1) addCleanup(c2) addCleanup(c3)
end

-- Generic 8-handle resize for floating panels (resizes the frame itself).
local function addResizeHandles(frame)
	local anchors = {
		{Vector2.new(0,0),Vector2.new(-1,-1)},{Vector2.new(1,0),Vector2.new(1,-1)},
		{Vector2.new(0,1),Vector2.new(-1,1)},{Vector2.new(1,1),Vector2.new(1,1)},
		{Vector2.new(.5,0),Vector2.new(0,-1)},{Vector2.new(.5,1),Vector2.new(0,1)},
		{Vector2.new(0,.5),Vector2.new(-1,0)},{Vector2.new(1,.5),Vector2.new(1,0)},
	}
	for _, d in ipairs(anchors) do
		local anc, dir = d[1], d[2]
		local h = el("Frame",{Size=UDim2.new(0,10,0,10),Position=UDim2.new(anc.X,dir.X*5,anc.Y,dir.Y*5),AnchorPoint=anc,BackgroundColor3=THEME.Blue,BorderSizePixel=0,ZIndex=200},frame)
		corner(10,h)
		local resizing,rStart,sSize,sPos2=false,nil,nil,nil
		h.InputBegan:Connect(function(i)
			if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
			resizing=true;rStart=i.Position;sSize=frame.Size;sPos2=frame.Position
		end)
		local c1=userInputService.InputChanged:Connect(function(i)
			if not resizing then return end
			if i.UserInputType~=Enum.UserInputType.MouseMovement and i.UserInputType~=Enum.UserInputType.Touch then return end
			local dv=i.Position-rStart
			local w,h2,x,y=sSize.X.Offset,sSize.Y.Offset,sPos2.X.Offset,sPos2.Y.Offset
			if anc.X==0 then w=math.max(160,w-dv.X);x=sPos2.X.Offset+(sSize.X.Offset-w)
			elseif anc.X==1 then w=math.max(160,w+dv.X) end
			if anc.Y==0 then h2=math.max(120,h2-dv.Y);y=sPos2.Y.Offset+(sSize.Y.Offset-h2)
			elseif anc.Y==1 then h2=math.max(120,h2+dv.Y) end
			frame.Size=UDim2.new(sSize.X.Scale,w,sSize.Y.Scale,h2)
			frame.Position=UDim2.new(sPos2.X.Scale,x,sPos2.Y.Scale,y)
		end)
		local c2=userInputService.InputEnded:Connect(function(i)
			if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then resizing=false end
		end)
		addCleanup(c1) addCleanup(c2)
	end
end

