	ensureFolder()

	screenGui=el("ScreenGui",{Name="GuiBuilderV2",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling},gethui and gethui() or localPlayer.PlayerGui)
