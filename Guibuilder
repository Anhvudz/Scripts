-- IMPORT HELPERS
local function extractImportBody(codeLines,lineStart)
	if lineStart<=0 or #codeLines==0 then return "" end
	local body={};local depth=0
	for i=lineStart,math.min(lineStart+60,#codeLines) do
		local ln=codeLines[i] or "";if i==lineStart and ln:match("function") then continue end
		for _ in ln:gmatch("%f[%a]function%f[%A]") do depth=depth+1 end
		for _ in ln:gmatch("%f[%a]do%f[%A]") do depth=depth+1 end
		local ec=0;for _ in ln:gmatch("%f[%a]end%f[%A]") do ec=ec+1 end;depth=depth-ec
		if ec>0 and depth<=0 then break end;table.insert(body,ln)
	end;return table.concat(body,"\n")
end
local function detectImportConnections(inst,codeLines)
	if not getconnections then return end
	for _,evtName in ipairs(ALL_DETECT_EVENTS) do
		local sigOk,signal=pcall(function()return inst[evtName]end)
		if not sigOk or typeof(signal)~="RBXScriptSignal" then continue end
		local cok,conns=pcall(getconnections,signal);if not cok or not conns then continue end
		for _,conn in ipairs(conns) do
			if not conn.LuaConnection then continue end;local fn=conn.Function;if not fn then continue end
			if isexecutorclosure and isexecutorclosure(fn) then continue end
			local code="-- "..evtName.." (captured)"
			local infoOk,fnInfo=pcall(debug.getinfo,fn)
			if infoOk and fnInfo then
				local src=fnInfo.source or "";local ls=fnInfo.linedefined or -1
				if (src:find(IMP_CHUNK,1,true) or src=="="..IMP_CHUNK) and ls>0 and #codeLines>0 then
					local extracted=extractImportBody(codeLines,ls);if extracted~="" then code=extracted end
				end
			end
			if not GuiBuilder.instances[inst] then GuiBuilder.instances[inst]={connections={},draggable=false,loadstringSource=nil} end
			if not GuiBuilder.instances[inst].connections then GuiBuilder.instances[inst].connections={} end
			table.insert(GuiBuilder.instances[inst].connections,{event=evtName,code=code,robloxConn=nil})
		end
	end
end
local function extractNonInstanceCode(code)
	local lines=code:split("\n");local out={};local added={}
	local pats={"while%s+true","RunService%.","Heartbeat%s*:","RenderStepped%s*:","Stepped%s*:","task%.wait","task%.delay","task%.spawn","game:GetService%(.\"RunService\"%)",}
	for i,ln in ipairs(lines) do
		if added[i] then continue end
		for _,pat in ipairs(pats) do
			if ln:match(pat) then
				local depth=0;for j=i,math.min(i+50,#lines) do
					if not added[j] then
						added[j]=true;table.insert(out,lines[j])
						for _ in lines[j]:gmatch("%f[%a]function%f[%A]") do depth=depth+1 end
						for _ in lines[j]:gmatch("%f[%a]do%f[%A]") do depth=depth+1 end
						for _ in lines[j]:gmatch("%f[%a]end%f[%A]") do depth=depth-1 end
						if j>i and depth<=0 then break end
					end
				end;break
			end
		end
	end;return table.concat(out,"\n")
end
