		connData.code=codeBox.Text;changed=false
		if onSave then onSave(connData) end;ed:Destroy()
	end)
	closeEd.Activated:Connect(function()
		if changed then showConfirm("Unsaved changes — close anyway?",function()ed:Destroy()end)
		else ed:Destroy() end
	end)
end

