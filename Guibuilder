-- Collects tagged root instances from all possible GUI containers.
local function collectRoots()
	local roots, seen = {}, {}
	local function scanParent(parent)
		if not parent then return end
		for _, child in ipairs(parent:GetChildren()) do
			if GuiBuilder.instances[child] and not seen[child] and child ~= mainFrame and child ~= toggleBtn and child ~= explorerFrame then
				seen[child] = true
				table.insert(roots, child)
			end
		end
	end
	scanParent(editGui)
	scanParent(localPlayer:FindFirstChildOfClass("PlayerGui"))
	if gethui then pcall(function()
		local hui = gethui()
		if hui then
			for _, child in ipairs(hui:GetChildren()) do
				if GuiBuilder.instances[child] and not seen[child] and child ~= screenGui then
					seen[child] = true
					table.insert(roots, child)
				end
			end
		end
	end) end
	return roots
end

local function buildExplorer(scrollFrame)
	for _, c in ipairs(scrollFrame:GetChildren()) do
		if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
	end

	local function buildNode(inst, depth)
		local row = el("Frame", { Size = UDim2.new(1,0,0,22), BackgroundTransparency = 1 }, scrollFrame)
		local isSel = GuiBuilder.selectedInstance == inst
		local bg = el("Frame", { Size = UDim2.new(1,0,1,0), BackgroundColor3 = THEME.Accent, BackgroundTransparency = isSel and 0.65 or 1, BorderSizePixel = 0 }, row)
		corner(4, bg)
		local lbl = el("TextButton", {
			Size = UDim2.new(1, -depth*10, 1, 0), Position = UDim2.new(0, depth*10, 0, 0),
			BackgroundTransparency = 1, Text = "  " .. inst.Name .. " [" .. inst.ClassName .. "]",
			TextColor3 = isSel and THEME.Text or THEME.SubText, TextSize = 11,
			Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		}, row)
		lbl.MouseEnter:Connect(function() if not isSel then tw(bg, { BackgroundTransparency = 0.88 }, 0.1) end end)
		lbl.MouseLeave:Connect(function() if not isSel then tw(bg, { BackgroundTransparency = 1 }, 0.1) end end)

		local lastClick = 0
		lbl.Activated:Connect(function()
			local now = tick()
			local isDouble = (now - lastClick) < DOUBLE_CLICK_TIME
			lastClick = now
			if isDouble then
				local children = inst:GetChildren()
				local panelH = math.min(260, #children * 26 + 70)
				local picker = el("Frame", {
					Size = UDim2.new(0,220,0,panelH), Position = UDim2.new(0.5,-110,0.5,-panelH/2),
					BackgroundColor3 = THEME.Surface, BorderSizePixel = 0, ZIndex = 300,
				}, screenGui)
				corner(8, picker) stroke(THEME.Border, 1, picker) makeDraggable(picker)
				local pHdr = el("Frame", { Size = UDim2.new(1,0,0,28), BackgroundColor3 = THEME.Panel, BorderSizePixel = 0, ZIndex = 301 }, picker)
				corner(8, pHdr)
				el("Frame", { Size = UDim2.new(1,0,0.5,0), Position = UDim2.new(0,0,0.5,0), BackgroundColor3 = THEME.Panel, BorderSizePixel = 0, ZIndex = 301 }, pHdr)
				el("TextLabel", { Size = UDim2.new(1,-30,1,0), Position = UDim2.new(0,8,0,0), BackgroundTransparency = 1, Text = "Children: " .. inst.Name, TextColor3 = THEME.Text, TextSize = 11, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 302 }, pHdr)
				local pClose = el("TextButton", { Size = UDim2.new(0,20,0,20), Position = UDim2.new(1,-24,0,4), BackgroundColor3 = THEME.Danger, BorderSizePixel = 0, Text = "✕", TextColor3 = THEME.Text, TextSize = 10, ZIndex = 302 }, pHdr)
				corner(4, pClose)
				pClose.Activated:Connect(function() picker:Destroy() end)
				local pScroll = el("ScrollingFrame", { Size = UDim2.new(1,0,1,-66), Position = UDim2.new(0,0,0,28), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ZIndex = 301 }, picker)
				el("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,2) }, pScroll)
				el("UIPadding", { PaddingLeft = UDim.new(0,4), PaddingRight = UDim.new(0,4), PaddingTop = UDim.new(0,4) }, pScroll)
				for _, child in ipairs(children) do
					local cBtn = el("TextButton", { Size = UDim2.new(1,0,0,22), BackgroundColor3 = THEME.Panel, BorderSizePixel = 0, Text = child.Name .. " [" .. child.ClassName .. "]", TextColor3 = THEME.Text, TextSize = 10, Font = Enum.Font.Gotham, AutoButtonColor = false, ZIndex = 302 }, pScroll)
					corner(4, cBtn)
					cBtn.Activated:Connect(function()
						GuiBuilder.selectedInstance = child; picker:Destroy()
						buildExplorer(scrollFrame)
						if currentTab == 2 and GuiBuilder.refreshInstanceTab then GuiBuilder.refreshInstanceTab() end
					end)
				end
				local pLayout = pScroll:FindFirstChildOfClass("UIListLayout")
				if pLayout then pScroll.CanvasSize = UDim2.new(0,0,0, pLayout.AbsoluteContentSize.Y + 8) end
				-- Create new instance textbox.
				local createRow = el("Frame", { Size = UDim2.new(1,-8,0,30), Position = UDim2.new(0,4,1,-38), BackgroundColor3 = THEME.Panel, BorderSizePixel = 0, ZIndex = 301 }, picker)
				corner(5, createRow)
				local cInput = el("TextBox", { Size = UDim2.new(1,-54,1,-6), Position = UDim2.new(0,4,0,3), BackgroundTransparency = 1, PlaceholderText = "ClassName...", Text = "", TextColor3 = THEME.Text, PlaceholderColor3 = THEME.SubText, TextSize = 10, Font = Enum.Font.Gotham, ClearTextOnFocus = false, ZIndex = 302 }, createRow)
				local cBtn2 = el("TextButton", { Size = UDim2.new(0,46,1,-6), Position = UDim2.new(1,-50,0,3), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0, Text = "Create", TextColor3 = THEME.Text, TextSize = 10, Font = Enum.Font.GothamMedium, ZIndex = 302 }, createRow)
				corner(4, cBtn2)
				cBtn2.Activated:Connect(function()
					if cInput.Text == "" then return end
					local ok, newInst = pcall(function() return Instance.new(cInput.Text) end)
					if not ok or not newInst then showNotif("❌ Invalid: " .. cInput.Text, THEME.Danger); return end
					-- Default size for GuiObjects.
					if newInst:IsA("GuiObject") then pcall(function() newInst.Size = UDim2.new(0,50,0,50) end) end
					newInst.Parent = inst
					tagInstance(newInst)
					picker:Destroy()
					buildExplorer(scrollFrame)
				end)
			else
				GuiBuilder.selectedInstance = inst
				buildExplorer(scrollFrame)
				if currentTab == 2 and GuiBuilder.refreshInstanceTab then GuiBuilder.refreshInstanceTab() end
			end
		end)

		-- Recurse into tagged children.
		for _, child in ipairs(inst:GetChildren()) do
			if GuiBuilder.instances[child] then buildNode(child, depth + 1) end
		end
	end

	for _, root in ipairs(collectRoots()) do
		buildNode(root, 0)
	end

	local layout = scrollFrame:FindFirstChildOfClass("UIListLayout")
	if layout then scrollFrame.CanvasSize = UDim2.new(0,0,0, layout.AbsoluteContentSize.Y + 8) end
end

-- =====================
-- EXPORT / SERIALIZE
-- =====================

local function serializeValue(val)
	local t = typeof(val)
	if t == "string" then return string.format("%q", val)
	elseif t == "number" then return tostring(val)
	elseif t == "boolean" then return tostring(val)
	elseif t == "Color3" then return string.format("Color3.fromRGB(%d,%d,%d)", math.round(val.R*255), math.round(val.G*255), math.round(val.B*255))
	elseif t == "UDim2" then return string.format("UDim2.new(%g,%g,%g,%g)", val.X.Scale, val.X.Offset, val.Y.Scale, val.Y.Offset)
	elseif t == "UDim" then return string.format("UDim.new(%g,%g)", val.Scale, val.Offset)
	elseif t == "Vector2" then return string.format("Vector2.new(%g,%g)", val.X, val.Y)
	elseif t == "EnumItem" then return "Enum." .. tostring(val.EnumType) .. "." .. val.Name
	else return "nil" end
end

local function exportGuiLines(inst, indent)
	indent = indent or ""
	local out = {}
	local var = "i_" .. inst.Name:gsub("[^%w]", "_")
	local src = GuiBuilder.instances[inst] and GuiBuilder.instances[inst].loadstringSource
	if src then table.insert(out, indent .. "-- via: " .. src) end
	table.insert(out, indent .. "local " .. var .. " = Instance.new(\"" .. inst.ClassName .. "\")")
	for _, prop in ipairs(SUPPORTED_PROPS[inst.ClassName] or {}) do
		local ok, v = pcall(function() return inst[prop] end)
		if ok then table.insert(out, indent .. var .. "." .. prop .. " = " .. serializeValue(v)) end
	end
	if GuiBuilder.instances[inst] then
		for _, cd in ipairs(GuiBuilder.instances[inst].connections or {}) do
			table.insert(out, indent .. var .. "." .. cd.event .. ":Connect(function()")
			for _, line in ipairs(cd.code:split("\n")) do table.insert(out, indent .. "\t" .. line) end
			table.insert(out, indent .. "end)")
		end
	end
	for _, child in ipairs(inst:GetChildren()) do
		if GuiBuilder.instances[child] then
			for _, l in ipairs(exportGuiLines(child, indent .. "\t")) do table.insert(out, l) end
			table.insert(out, indent .. "i_" .. child.Name:gsub("[^%w]","_") .. ".Parent = " .. var)
		end
	end
	return out
end

-- =====================
-- SAVE / LOAD
-- =====================

local function ensureFolder()
	if not isfolder(FOLDER_NAME) then makefolder(FOLDER_NAME) end
end

local function saveGui(name)
	ensureFolder()
	local data = { name = name, version = "1", instances = {} }
	local function serInst(inst, pid)
		local id = #data.instances + 1
		local props = {}
		for _, p in ipairs(SUPPORTED_PROPS[inst.ClassName] or {}) do
			local ok, v = pcall(function() return inst[p] end)
			if ok then props[p] = serializeValue(v) end
		end
		-- Save connection code.
		local conns = {}
		if GuiBuilder.instances[inst] then
			for _, cd in ipairs(GuiBuilder.instances[inst].connections or {}) do
				table.insert(conns, { event = cd.event, code = cd.code })
			end
		end
		table.insert(data.instances, { id = id, parentId = pid, className = inst.ClassName, props = props, connections = conns, source = (GuiBuilder.instances[inst] and GuiBuilder.instances[inst].loadstringSource) })
		for _, child in ipairs(inst:GetChildren()) do
			if GuiBuilder.instances[child] then serInst(child, id) end
		end
	end
	for _, root in ipairs(collectRoots()) do
		if root ~= editGui then serInst(root, 0)
		else
			for _, child in ipairs(editGui:GetChildren()) do
				if GuiBuilder.instances[child] then serInst(child, 0) end
			end
		end
	end
	local ok, json = pcall(function() return httpService:JSONEncode(data) end)
	if ok then
		writefile(FOLDER_NAME .. "/" .. name .. ".gbf", json)
		return true, FOLDER_NAME .. "/" .. name .. ".gbf"
	end
	return false, "JSONEncode failed"
end

