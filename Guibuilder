	local function switchTab(idx)
		currentTab=idx
		for i,panel in ipairs(tabs) do panel.Visible=(i==idx) end
		for i,btn in ipairs(tabBtns) do
			tw(btn,{BackgroundColor3=i==idx and THEME.Accent or THEME.Panel,TextColor3=i==idx and THEME.Text or THEME.SubText},0.13)
		end
		if idx==2 then GuiBuilder.refreshInstanceTab() end
	end

	for i,name in ipairs(tabNames) do
