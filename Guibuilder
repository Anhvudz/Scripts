	el("UIPadding",{PaddingLeft=UDim.new(0,4),PaddingRight=UDim.new(0,4),PaddingTop=UDim.new(0,4)},loadList)
	local function refreshLoadList()
		for _,c in ipairs(loadList:GetChildren()) do if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end end
		local ok,files=pcall(listfiles,FOLDER_NAME)
		if not ok or not files or #files==0 then
			el("TextLabel",{Size=UDim2.new(1,0,0,24),BackgroundTransparency=1,Text="No saved files found.",TextColor3=THEME.SubText,TextSize=11},loadList);return
		end
		for _,fpath in ipairs(files) do
			if not fpath:find("%.gbf$") then continue end
			local fname=fpath:match("([^/\\]+)$") or fpath
			local row=el("Frame",{Size=UDim2.new(1,0,0,26),BackgroundTransparency=1},loadList)
			el("TextLabel",{Size=UDim2.new(1,-80,1,0),BackgroundTransparency=1,Text="📄 "..fname,TextColor3=THEME.Text,TextSize=10,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},row)
			local lBtn=el("TextButton",{Size=UDim2.new(0,48,0,20),Position=UDim2.new(1,-74,0,3),BackgroundColor3=THEME.Accent,BorderSizePixel=0,Text="Load",TextColor3=THEME.Text,TextSize=9,Font=Enum.Font.GothamMedium},row)
			corner(4,lBtn)
			local rBtn=el("TextButton",{Size=UDim2.new(0,20,0,20),Position=UDim2.new(1,-24,0,3),BackgroundColor3=THEME.Warning,BorderSizePixel=0,Text="↺",TextColor3=Color3.new(0,0,0),TextSize=11},row)
			corner(4,rBtn)
			local function tryLoad()
				local rok,content=pcall(readfile,fpath)
				if not rok then showNotif("❌ Read error",THEME.Danger);return end
				local pok,data=pcall(function()return httpService:JSONDecode(content)end)
				if not pok then showNotif("❌ Parse error",THEME.Danger);return end
				-- Restore script code if saved.
				if data.scriptCode and data.scriptCode~="" then
					GuiBuilder.scriptCode=data.scriptCode;scriptBox.Text=data.scriptCode
				end
				local instMap,fail={},0
				for _,d in ipairs(data.instances or {}) do
					local cok,newInst=pcall(function()return Instance.new(d.className)end)
					if cok and newInst then
						for p,v in pairs(d.props or {}) do
							pcall(function()
								local fn=loadstring("return "..v)
								if fn then local fok,val=pcall(fn);if fok and val~=nil then newInst[p]=val end end
							end)
						end
						newInst.Parent=d.parentId==0 and editGui or (instMap[d.parentId] or editGui)
						tagInstance(newInst,d.source)
						if d.draggable then
							GuiBuilder.instances[newInst].draggable=true;pcall(function()makeDraggable(newInst)end)
						end
						instMap[d.id]=newInst
						-- Restore connections.
						for _,cd in ipairs(d.connections or {}) do
							if cd.event and cd.code then
								local fn=loadstring("return function()\n"..cd.code.."\nend")
								if fn then
									local cok2,rConn=pcall(function()return newInst[cd.event]:Connect(fn())end)
									if cok2 and rConn then
										table.insert(GuiBuilder.instances[newInst].connections,{event=cd.event,code=cd.code,robloxConn=rConn})
									end
								end
							end
						end
					else fail=fail+1 end
				end
				if fail>0 then showNotif("⚠ Loaded with "..fail.." errors",THEME.Warning)
				else showNotif("✓ Loaded: "..fname,THEME.Success) end
				if explorerFrame.Visible then buildExplorer(explorerScroll) end
			end
			lBtn.Activated:Connect(tryLoad);rBtn.Activated:Connect(tryLoad)
		end
		local ll=loadList:FindFirstChildOfClass("UIListLayout")
		if ll then loadList.CanvasSize=UDim2.new(0,0,0,ll.AbsoluteContentSize.Y+8) end
	end
	createButton(t3,"🔄 Refresh",refreshLoadList)
	refreshLoadList()

	-- =====================
	-- TAB 4: SETTINGS
	-- =====================
	local t4=tabs[4]
	createSectionHeader(t4,"APPEARANCE")
	createSlider(t4,"Main Frame Transparency",0,1,0,function(v)mainFrame.BackgroundTransparency=v end)
	createSeparator(t4)
	createSectionHeader(t4,"CLEAR GUI")
	createButton(t4,"🗑 Clear All Instances",function()
		showConfirm("Delete all created instances?",function()
			for inst in pairs(GuiBuilder.instances) do
				if inst~=editGui then untagInstance(inst);pcall(function()inst:Destroy()end) end
			end
			GuiBuilder.instances={};tagInstance(editGui)
			GuiBuilder.selected=nil;hideSelectionOverlay()
			showNotif("✓ Cleared",THEME.Success)
			if explorerFrame.Visible then buildExplorer(explorerScroll) end
		end)
	end)
	createSeparator(t4)
	createSectionHeader(t4,"IMPORT SCRIPT")
	local importArea=el("Frame",{Size=UDim2.new(1,0,0,0),BackgroundColor3=THEME.Surface,BorderSizePixel=0,ClipsDescendants=true},t4)
	corner(6,importArea)
	local importOpen=false
	createButton(t4,"📥 Toggle Import Panel",function()
		importOpen=not importOpen;tw(importArea,{Size=UDim2.new(1,0,0,importOpen and 250 or 0)},0.18)
	end)
	local importBox=el("TextBox",{
		Size=UDim2.new(1,-16,0,140),Position=UDim2.new(0,8,0,8),
		BackgroundColor3=THEME.Panel,BorderSizePixel=0,
		PlaceholderText="Paste script here...",Text="",
		TextColor3=THEME.Text,PlaceholderColor3=THEME.SubText,
		TextSize=11,Font=Enum.Font.Code,MultiLine=true,
		ClearTextOnFocus=false,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,
	},importArea)
	corner(5,importBox)
	local analysisScroll=el("ScrollingFrame",{Size=UDim2.new(0.48,-4,0,76),Position=UDim2.new(0,8,0,156),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3},importArea)
	el("UIListLayout",{FillDirection=Enum.FillDirection.Vertical,SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,2)},analysisScroll)
	local execBtn=el("TextButton",{Size=UDim2.new(0.48,-4,0,36),Position=UDim2.new(0.52,0,0,154),BackgroundColor3=THEME.Accent,BorderSizePixel=0,Text="▶ Execute",TextColor3=THEME.Text,TextSize=12,Font=Enum.Font.GothamMedium},importArea)
	corner(6,execBtn)
	execBtn.Activated:Connect(function()
		local code=importBox.Text
		if code=="" then showNotif("No script",THEME.Warning);return end
		for _,c in ipairs(analysisScroll:GetChildren()) do if not c:IsA("UIListLayout") then c:Destroy() end end
		-- Detect hub URL.
		local hubUrl=code:match('loadstring%(game:HttpGet%("(.-)"%)')
			or code:match("loadstring%(game:HttpGet%('(.-)'%)")
		if hubUrl then
			el("TextLabel",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text="🔗 "..( hubUrl:match("([^/]+)$") or hubUrl),TextColor3=THEME.Warning,TextSize=10,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left},analysisScroll)
		end
		for fnName in code:gmatch("function%s+([%w_]+)%s*%(") do
			if code:find(fnName) and (code:find("Instance%.new") or code:find("Frame") or code:find("ScreenGui")) then
				local b=el("TextButton",{Size=UDim2.new(1,0,0,18),BackgroundColor3=THEME.Panel,BorderSizePixel=0,Text="📦 "..fnName,TextColor3=THEME.Text,TextSize=10,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false},analysisScroll)
				corner(3,b)
			end
		end
		local al=analysisScroll:FindFirstChildOfClass("UIListLayout")
		if al then analysisScroll.CanvasSize=UDim2.new(0,0,0,al.AbsoluteContentSize.Y+4) end
		-- Snapshot all GUI containers before execution.
		local before={}
		local function snapshotTree(root)
			if not root then return end;before[root]=true
			for _,d in ipairs(root:GetDescendants()) do before[d]=true end
		end
		snapshotTree(screenGui)
		local playerGui = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
		if playerGui then snapshotTree(playerGui) end
		if gethui then pcall(function()
			local hui=gethui();if hui then snapshotTree(hui) end
		end) end
		-- Execute with named chunk for source tracking.
		local fn,err=loadstring(code,IMPORT_CHUNK)
		if not fn then showNotif("❌ Syntax: "..tostring(err),THEME.Danger);return end
		local rok,rerr=pcall(fn)
		if not rok then showNotif("❌ Runtime: "..tostring(rerr),THEME.Danger);return end
		local codeLines = type(code)=="string" and code:split("\n") or {}
		-- Tag all new instances and detect their connections.
		safeSpawn(function()
			local count=0
			local function findNew(root)
				if not root then return end
				for _,child in ipairs(root:GetChildren()) do
					if not before[child] then
						if child:IsA("GuiBase") or child:IsA("GuiObject") or child:IsA("ScreenGui") then
							tagInstance(child,hubUrl or "import");count=count+1
							detectImportConnections(child,codeLines)
							for _,d in ipairs(child:GetDescendants()) do
								if not before[d] then
									tagInstance(d,hubUrl or "import");count=count+1
									detectImportConnections(d,codeLines)
								end
							end
						end
					else findNew(child) end
				end
			end
			findNew(screenGui)
			if playerGui then pcall(function() findNew(playerGui) end) end
			if gethui then pcall(function()
				local hui=gethui();if hui then findNew(hui) end
			end) end
			showNotif("✓ Tagged "..count.." instances",THEME.Success)
			if explorerFrame.Visible then buildExplorer(explorerScroll) end
		end)
	end)
	createSeparator(t4)
	createSectionHeader(t4,"EXPORT SCRIPT")
	createButton(t4,"📤 Export to Clipboard",function()
		local header={"-- Generated by GuiBuilder","-- "..os.date(),""}
		local bodyLines=buildExportScript(collectRoots(),GuiBuilder.scriptCode)
		local all={}
		for _,l in ipairs(header) do table.insert(all,l) end
		for _,l in ipairs(bodyLines) do table.insert(all,l) end
		setclipboard(table.concat(all,"\n"))
		showNotif("✓ Exported to clipboard!",THEME.Success)
	end,true)

	-- Register singleton.
	shared.GuiBuilder={
		destroy=function()
			cleanup();hideSelectionOverlay()
			pcall(function()screenGui:Destroy()end)
			GuiBuilder.instances={};GuiBuilder.selected=nil;shared.GuiBuilder=nil
		end,
	}
	showNotif("✓ GuiBuilder loaded!",THEME.Success)
end

local function onErr(err)
	warn("[GuiBuilder] Failed."); warn(err); warn(debug.traceback())
end

xpcall(buildMainGui,onErr)
