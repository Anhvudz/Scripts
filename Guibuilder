	createSlider(t1,"Resize Increment",1,50,1,function(v)GuiBuilder.resizeInc=v end)
	createSeparator(t1)
	createSectionHeader(t1,"CREATE INSTANCE")
	local _,classInp=createTextInput(t1,"Instance Class","e.g. Frame, TextLabel...")
	createButton(t1,"+ Create Instance",function()
		local cls=classInp.Text
		if cls=="" then showNotif("Enter a class name",THEME.Warning);return end
		local ok,newInst=pcall(function()return Instance.new(cls)end)
		if not ok or not newInst then showNotif("❌ Invalid: "..cls,THEME.Danger);return end
		if newInst:IsA("GuiObject") then pcall(function()newInst.Size=UDim2.new(0,50,0,50)end) end
		local parentTarget=GuiBuilder.selected or editGui
		newInst.Parent=parentTarget;tagInstance(newInst)
		showNotif("✓ Created "..cls.." → "..parentTarget.Name,THEME.Success)
		if explorerFrame.Visible then buildExplorer(explorerScroll) end
	end,true)
