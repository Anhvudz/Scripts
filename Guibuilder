-- =====================

local function makeDraggable(frame, handle)
	handle = handle or frame
	local dragging, dragStart, startPos = false, nil, nil
	local c1 = handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dragStart = input.Position; startPos = frame.Position
		end
	end)
	local c2 = userInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local d = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
	end)
	local c3 = userInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	addCleanup(c1) addCleanup(c2) addCleanup(c3)
end

-- Eight blue resize handles for a frame.
local function addResizeHandles(frame)
	local anchors = {
		{ Vector2.new(0,0), Vector2.new(-1,-1) }, { Vector2.new(1,0), Vector2.new(1,-1) },
		{ Vector2.new(0,1), Vector2.new(-1,1)  }, { Vector2.new(1,1), Vector2.new(1,1)  },
		{ Vector2.new(0.5,0), Vector2.new(0,-1) }, { Vector2.new(0.5,1), Vector2.new(0,1) },
		{ Vector2.new(0,0.5), Vector2.new(-1,0) }, { Vector2.new(1,0.5), Vector2.new(1,0) },
	}
	for _, data in ipairs(anchors) do
		local anchor, dir = data[1], data[2]
		local handle = el("Frame", {
			Size = UDim2.new(0,10,0,10), Position = UDim2.new(anchor.X, dir.X*5, anchor.Y, dir.Y*5),
			AnchorPoint = anchor, BackgroundColor3 = THEME.Blue, BorderSizePixel = 0, ZIndex = 200,
		}, frame)
		corner(10, handle)
		local resizing, resizeStart, startSize, startPos = false, nil, nil, nil
		handle.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
			resizing = true; resizeStart = input.Position; startSize = frame.Size; startPos = frame.Position
		end)
		local c1 = userInputService.InputChanged:Connect(function(input)
			if not resizing then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local d = input.Position - resizeStart
			local w, h, x, y = startSize.X.Offset, startSize.Y.Offset, startPos.X.Offset, startPos.Y.Offset
			if anchor.X == 0 then w = math.max(160, w - d.X); x = startPos.X.Offset + (startSize.X.Offset - w)
			elseif anchor.X == 1 then w = math.max(160, w + d.X) end
			if anchor.Y == 0 then h = math.max(120, h - d.Y); y = startPos.Y.Offset + (startSize.Y.Offset - h)
			elseif anchor.Y == 1 then h = math.max(120, h + d.Y) end
			frame.Size = UDim2.new(startSize.X.Scale, w, startSize.Y.Scale, h)
			frame.Position = UDim2.new(startPos.X.Scale, x, startPos.Y.Scale, y)
		end)
		local c2 = userInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then resizing = false end
		end)
		addCleanup(c1) addCleanup(c2)
	end
end

