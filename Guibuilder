local function createToggle(parent, label, default, onChange)
	local c = el("Frame",{Size=UDim2.new(1,0,0,30),BackgroundTransparency=1},parent)
	el("TextLabel",{Size=UDim2.new(1,-50,1,0),BackgroundTransparency=1,Text=label,TextColor3=THEME.Text,TextSize=12,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},c)
	local track=el("Frame",{Size=UDim2.new(0,38,0,20),Position=UDim2.new(1,-40,0.5,-10),BackgroundColor3=THEME.Border,BorderSizePixel=0},c)
	corner(10,track)
	local knob=el("Frame",{Size=UDim2.new(0,15,0,15),Position=UDim2.new(0,2,0.5,-7),BackgroundColor3=THEME.Text,BorderSizePixel=0},track)
	corner(10,knob)
	local state=default or false
	local function setState(v)
		state=v
		tw(track,{BackgroundColor3=state and THEME.Accent or THEME.Border},0.18)
		tw(knob,{Position=state and UDim2.new(1,-17,0.5,-7) or UDim2.new(0,2,0.5,-7)},0.18)
		if onChange then onChange(state) end
	end
	setState(state)
	track.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then setState(not state) end
	end)
	return c,function()return state end,setState
end

local function createSlider(parent, label, min, max, default, onChange)
	local c=el("Frame",{Size=UDim2.new(1,0,0,46),BackgroundTransparency=1},parent)
	local vl=el("TextLabel",{Size=UDim2.new(0,36,0,18),Position=UDim2.new(1,-36,0,0),BackgroundTransparency=1,Text=tostring(default),TextColor3=THEME.SubText,TextSize=11,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Right},c)
	el("TextLabel",{Size=UDim2.new(1,-40,0,18),BackgroundTransparency=1,Text=label,TextColor3=THEME.Text,TextSize=12,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},c)
	local track=el("Frame",{Size=UDim2.new(1,0,0,5),Position=UDim2.new(0,0,0,26),BackgroundColor3=THEME.Border,BorderSizePixel=0},c)
	corner(4,track)
	local fill=el("Frame",{Size=UDim2.new(0,0,1,0),BackgroundColor3=THEME.Accent,BorderSizePixel=0},track)
	corner(4,fill)
	local knob2=el("Frame",{Size=UDim2.new(0,13,0,13),Position=UDim2.new(0,-6,0.5,-6),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=5},track)
	corner(10,knob2)
	local value=default or min
	local dragging=false
	local function setValue(v)
		value=math.clamp(v,min,max)
		local pct=(value-min)/(max-min)
		fill.Size=UDim2.new(pct,0,1,0)
		knob2.Position=UDim2.new(pct,-6,0.5,-6)
		vl.Text=tostring(math.round(value*100)/100)
		if onChange then onChange(value) end
	end
	local function fromInput(i)
		local pct=math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
		setValue(min+(max-min)*pct)
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=true;fromInput(i) end
	end)
	local c1=userInputService.InputChanged:Connect(function(i)
		if dragging and(i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then fromInput(i) end
	end)
	local c2=userInputService.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=false end
	end)
	addCleanup(c1) addCleanup(c2)
	setValue(value)
	return c,function()return value end,setValue
end

local function createTextInput(parent, label, placeholder, onChange)
	local h=label and 52 or 32
	local c=el("Frame",{Size=UDim2.new(1,0,0,h),BackgroundTransparency=1},parent)
	if label then el("TextLabel",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text=label,TextColor3=THEME.Text,TextSize=12,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},c) end
	local iFrame=el("Frame",{Size=UDim2.new(1,0,0,30),Position=UDim2.new(0,0,0,label and 20 or 0),BackgroundColor3=THEME.Surface,BorderSizePixel=0},c)
	corner(6,iFrame)
	local stk=stroke(THEME.Border,1,iFrame)
	local inp=el("TextBox",{Size=UDim2.new(1,-12,1,0),Position=UDim2.new(0,6,0,0),BackgroundTransparency=1,PlaceholderText=placeholder or "",Text="",TextColor3=THEME.Text,PlaceholderColor3=THEME.SubText,TextSize=12,Font=Enum.Font.Gotham,ClearTextOnFocus=false},iFrame)
	inp.Focused:Connect(function() tw(stk,{Color=THEME.Accent},0.12) end)
