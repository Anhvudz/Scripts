local function serializeValue(val)
	local t=typeof(val)
	if t=="string" then return string.format("%q",val)
	elseif t=="number" then return tostring(val)
	elseif t=="boolean" then return tostring(val)
	elseif t=="Color3" then return string.format("Color3.fromRGB(%d,%d,%d)",math.round(val.R*255),math.round(val.G*255),math.round(val.B*255))
	elseif t=="UDim2" then return string.format("UDim2.new(%g,%g,%g,%g)",val.X.Scale,val.X.Offset,val.Y.Scale,val.Y.Offset)
	elseif t=="UDim" then return string.format("UDim.new(%g,%g)",val.Scale,val.Offset)
	elseif t=="Vector2" then return string.format("Vector2.new(%g,%g)",val.X,val.Y)
	elseif t=="Vector3" then return string.format("Vector3.new(%g,%g,%g)",val.X,val.Y,val.Z)
	elseif t=="EnumItem" then return "Enum."..tostring(val.EnumType).."."..val.Name
	elseif t=="Rect" then return string.format("Rect.new(%g,%g,%g,%g)",val.Min.X,val.Min.Y,val.Max.X,val.Max.Y)
	else return "nil" end
end

-- Build export script lines. Uses counter-based unique var names to avoid collisions.
local function buildExportScript(roots, scriptCode)
	local lines={}
	local ctr=0
	local varMap={}

	-- Include makeDraggable helper if any instance is draggable.
	local hasDraggable=false
	for inst,data in pairs(GuiBuilder.instances) do
		if data.draggable then hasDraggable=true;break end
	end

	if hasDraggable then
		for _,l in ipairs({
			"local _uis = game:GetService(\"UserInputService\")",
			"local function makeDraggable(frame, handle)",
			"\thandle = handle or frame",
			"\tlocal drag, ds, sp = false, nil, nil",
			"\thandle.InputBegan:Connect(function(i)",
			"\t\tif i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then",
			"\t\t\tdrag = true; ds = i.Position; sp = frame.Position",
			"\t\tend",
			"\tend)",
			"\t_uis.InputChanged:Connect(function(i)",
			"\t\tif not drag then return end",
			"\t\tif i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end",
			"\t\tlocal d = i.Position - ds",
			"\t\tframe.Position = UDim2.new(sp.X.Scale, sp.X.Offset+d.X, sp.Y.Scale, sp.Y.Offset+d.Y)",
			"\tend)",
			"\t_uis.InputEnded:Connect(function(i)",
			"\t\tif i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag=false end",
			"\tend)",
			"end",
			"",
		}) do table.insert(lines,l) end
	end

	local function getVar(inst)
		if varMap[inst] then return varMap[inst] end
		ctr=ctr+1
		varMap[inst]="i"..ctr.."_"..inst.Name:gsub("[^%w]","_")
		return varMap[inst]
	end

	local function processInst(inst, parentVar)
		if inst.Name==OVERLAY_NAME then return end
		local data=GuiBuilder.instances[inst]
		if not data then return end
		local var=getVar(inst)
		local src=data.loadstringSource
		if src then table.insert(lines,"-- via: "..src) end
		table.insert(lines,"local "..var.." = Instance.new(\""..inst.ClassName.."\")")
		-- Properties.
		for _,prop in ipairs(SUPPORTED_PROPS[inst.ClassName] or {}) do
			local ok,v=pcall(function()return inst[prop]end)
			if ok then
				local s=serializeValue(v)
				if s~="nil" then table.insert(lines,var.."."..prop.." = "..s) end
			end
		end
		-- Connections.
		for _,cd in ipairs(data.connections or {}) do
			table.insert(lines,var.."."..cd.event..":Connect(function()")
			for _,ln in ipairs(cd.code:split("\n")) do table.insert(lines,"\t"..ln) end
			table.insert(lines,"end)")
		end
		-- Draggable.
		if data.draggable then table.insert(lines,"makeDraggable("..var..")") end
		-- Set parent after properties/connections, before children.
		if parentVar then table.insert(lines,var..".Parent = "..parentVar) end
		-- Children.
		for _,child in ipairs(inst:GetChildren()) do
			if GuiBuilder.instances[child] and child.Name~=OVERLAY_NAME then
				processInst(child, var)
			end
		end
	end

	-- ScreenGui parent.
	table.insert(lines,"local sg = Instance.new(\"ScreenGui\")")
	table.insert(lines,"sg.Name = \"ExportedGui\"")
	table.insert(lines,"sg.ResetOnSpawn = false")
	table.insert(lines,"sg.Parent = gethui()")
	table.insert(lines,"")

	for _,root in ipairs(roots) do
		if root==editGui then
			for _,child in ipairs(editGui:GetChildren()) do
				if GuiBuilder.instances[child] and child.Name~=OVERLAY_NAME then
					processInst(child,"sg")
				end
			end
		else
			processInst(root,"sg")
		end
	end

	-- Append GUI script code if present.
	if scriptCode and scriptCode~="" then
		table.insert(lines,"")
		table.insert(lines,"-- GUI Script")
		table.insert(lines,"task.spawn(function()")
		for _,ln in ipairs(scriptCode:split("\n")) do
			table.insert(lines,"\t"..ln)
		end
		table.insert(lines,"end)")
	end

	return lines
end

