-- INSTANCE TAB REFRESH
-- =====================

function GuiBuilder.refreshInstanceTab()
	if not GuiBuilder._propPanel then return end
	local propPanel=GuiBuilder._propPanel
	local eventPanel=GuiBuilder._eventPanel
	local connListFrame=GuiBuilder._connListFrame
	local noSelLabel=GuiBuilder._noSelLabel
	local instSplit=GuiBuilder._instSplit

	for _,c in ipairs(propPanel:GetChildren()) do if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end end
	for _,c in ipairs(eventPanel:GetChildren()) do c:Destroy() end
	for _,c in ipairs(connListFrame:GetChildren()) do if not c:IsA("UIListLayout") and not c:IsA("UIPadding") and not c:IsA("TextLabel") then c:Destroy() end end

	local inst=GuiBuilder.selected
	if not inst then
		noSelLabel.Visible=true;instSplit.Visible=false;hideSelectionOverlay();return
	end
	noSelLabel.Visible=false;instSplit.Visible=true

	-- Show move/resize overlay on selected instance.
	showSelectionOverlay(inst)

	el("TextLabel",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text="📌 "..inst.ClassName.." : "..inst.Name,TextColor3=THEME.Accent,TextSize=11,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},propPanel)

	-- Render property editors based on value type.
	for _,propName in ipairs(SUPPORTED_PROPS[inst.ClassName] or {}) do
		local ok,propVal=pcall(function()return inst[propName]end)
		if not ok then continue end
		local propType=typeof(propVal)

		if propType=="boolean" then
			createToggle(propPanel,propName,propVal,function(v) pcall(function()inst[propName]=v end) end)

		elseif propType=="number" then
			local mn,mx=0,1
			if propName=="ZIndex" then mn,mx=1,100
			elseif propName=="TextSize" then mn,mx=8,96
			elseif propName=="BorderSizePixel" then mn,mx=0,10
			elseif propName=="Rotation" then mn,mx=-180,180
			elseif propName=="ScrollBarThickness" then mn,mx=0,20
			elseif propName=="DisplayOrder" then mn,mx=0,1000
			elseif propName=="MaxVisibleGraphemes" then mn,mx=-1,200
			elseif propName=="LayoutOrder" then mn,mx=-100,100
			elseif propName=="LineHeight" then mn,mx=0.5,3
			elseif propName=="TextStrokeTransparency" then mn,mx=0,1
			elseif propName=="TextTransparency" then mn,mx=0,1
			elseif propName=="ImageTransparency" then mn,mx=0,1
			elseif propName=="ScrollBarImageTransparency" then mn,mx=0,1 end
			createSlider(propPanel,propName,mn,mx,propVal,function(v) pcall(function()inst[propName]=v end) end)

		elseif propType=="Color3" then
			local _,hexInp=createTextInput(propPanel,propName,"#RRGGBB")
			hexInp.Text=string.format("#%02X%02X%02X",math.round(propVal.R*255),math.round(propVal.G*255),math.round(propVal.B*255))
			hexInp.FocusLost:Connect(function()
				local h=hexInp.Text:gsub("#","")
				local r,g,b=tonumber(h:sub(1,2),16),tonumber(h:sub(3,4),16),tonumber(h:sub(5,6),16)
				if r and g and b then pcall(function()inst[propName]=Color3.fromRGB(r,g,b)end) end
			end)

		elseif propType=="UDim2" then
			local frame=el("Frame",{Size=UDim2.new(1,0,0,58),BackgroundTransparency=1},propPanel)
			el("TextLabel",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,Text=propName,TextColor3=THEME.Text,TextSize=12,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},frame)
			local vals={propVal.X.Scale,propVal.X.Offset,propVal.Y.Scale,propVal.Y.Offset}
			local lbls={"XS","XO","YS","YO"}
			local row=el("Frame",{Size=UDim2.new(1,0,0,38),Position=UDim2.new(0,0,0,18),BackgroundTransparency=1},frame)
			for j=1,4 do
				local col=el("Frame",{Size=UDim2.new(0.25,-2,1,0),Position=UDim2.new((j-1)*0.25,j>1 and 2 or 0,0,0),BackgroundTransparency=1},row)
				el("TextLabel",{Size=UDim2.new(1,0,0,13),BackgroundTransparency=1,Text=lbls[j],TextColor3=THEME.SubText,TextSize=9,Font=Enum.Font.Gotham},col)
				local inp=el("TextBox",{Size=UDim2.new(1,0,0,22),Position=UDim2.new(0,0,0,14),BackgroundColor3=THEME.Surface,BorderSizePixel=0,Text=tostring(vals[j]),TextColor3=THEME.Text,TextSize=10,ClearTextOnFocus=false},col)
				corner(4,inp)
				local captJ=j
				inp.FocusLost:Connect(function()
					vals[captJ]=tonumber(inp.Text) or vals[captJ]
					pcall(function()inst[propName]=UDim2.new(vals[1],vals[2],vals[3],vals[4])end)
				end)
			end

		elseif propType=="EnumItem" then
			local enumType=propVal.EnumType
			local opts={}
			for _,v in ipairs(Enum[tostring(enumType)]:GetEnumItems()) do table.insert(opts,v.Name) end
			createDropdown(propPanel,propName,opts,propVal.Name,function(v)
				pcall(function()inst[propName]=Enum[tostring(enumType)][v]end)
			end)

		elseif propType=="string" then
			local _,inp=createTextInput(propPanel,propName,"")
			inp.Text=propVal
			inp.FocusLost:Connect(function() pcall(function()inst[propName]=inp.Text end) end)

		elseif propType=="Vector2" then
			local frame=el("Frame",{Size=UDim2.new(1,0,0,56),BackgroundTransparency=1},propPanel)
			el("TextLabel",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,Text=propName,TextColor3=THEME.Text,TextSize=12,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},frame)
			local vals={propVal.X,propVal.Y}
			for k=1,2 do
				local col=el("Frame",{Size=UDim2.new(0.5,-2,0,36),Position=UDim2.new((k-1)*0.5,k>1 and 2 or 0,0,18),BackgroundTransparency=1},frame)
				el("TextLabel",{Size=UDim2.new(1,0,0,13),BackgroundTransparency=1,Text=k==1 and "X" or "Y",TextColor3=THEME.SubText,TextSize=9},col)
				local inp=el("TextBox",{Size=UDim2.new(1,0,0,22),Position=UDim2.new(0,0,0,14),BackgroundColor3=THEME.Surface,BorderSizePixel=0,Text=tostring(vals[k]),TextColor3=THEME.Text,TextSize=10,ClearTextOnFocus=false},col)
				corner(4,inp)
				local captK=k
				inp.FocusLost:Connect(function()
					vals[captK]=tonumber(inp.Text) or vals[captK]
					pcall(function()inst[propName]=Vector2.new(vals[1],vals[2])end)
				end)
			end

		elseif propType=="Vector3" then
			local frame=el("Frame",{Size=UDim2.new(1,0,0,56),BackgroundTransparency=1},propPanel)
			el("TextLabel",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,Text=propName,TextColor3=THEME.Text,TextSize=12,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},frame)
			local vals={propVal.X,propVal.Y,propVal.Z}
			local lbls3={"X","Y","Z"}
			for k=1,3 do
				local col=el("Frame",{Size=UDim2.new(0.33,-2,0,36),Position=UDim2.new((k-1)*0.33,k>1 and 2 or 0,0,18),BackgroundTransparency=1},frame)
				el("TextLabel",{Size=UDim2.new(1,0,0,13),BackgroundTransparency=1,Text=lbls3[k],TextColor3=THEME.SubText,TextSize=9},col)
				local inp=el("TextBox",{Size=UDim2.new(1,0,0,22),Position=UDim2.new(0,0,0,14),BackgroundColor3=THEME.Surface,BorderSizePixel=0,Text=tostring(vals[k]),TextColor3=THEME.Text,TextSize=10,ClearTextOnFocus=false},col)
				corner(4,inp)
				local captK=k
				inp.FocusLost:Connect(function()
					vals[captK]=tonumber(inp.Text) or vals[captK]
					pcall(function()inst[propName]=Vector3.new(vals[1],vals[2],vals[3])end)
				end)
			end
		end
	end

	-- Draggable toggle.
	if inst:IsA("GuiObject") then
		local instData=GuiBuilder.instances[inst]
		createToggle(propPanel,"Draggable (export)",instData and instData.draggable or false,function(v)
			if GuiBuilder.instances[inst] then GuiBuilder.instances[inst].draggable=v end
			if v then makeDraggable(inst) end
		end)
	end

	local propLayout=propPanel:FindFirstChildOfClass("UIListLayout")
	if propLayout then propPanel.CanvasSize=UDim2.new(0,0,0,propLayout.AbsoluteContentSize.Y+16) end

	-- Event panel.
	el("TextLabel",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text="Events",TextColor3=THEME.SubText,TextSize=10,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left},eventPanel)
	local evtScroll=el("ScrollingFrame",{Size=UDim2.new(1,0,1,-18),Position=UDim2.new(0,0,0,18),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3},eventPanel)
	el("UIListLayout",{FillDirection=Enum.FillDirection.Vertical,SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,3)},evtScroll)
	el("UIPadding",{PaddingTop=UDim.new(0,2)},evtScroll)
	local _,custEvtInp=createTextInput(evtScroll,nil,"Event name...")
	createButton(evtScroll,"+ Connect",function()
		local evtName=custEvtInp.Text
		if evtName=="" then showNotif("Enter event name",THEME.Warning);return end
		if not GuiBuilder.instances[inst] then GuiBuilder.instances[inst]={connections={}} end
		local cd={event=evtName,code='print("'..evtName..' fired")'}
		local fn=loadstring("return function()\n"..cd.code.."\nend")
		if not fn then showNotif("❌ Bad code",THEME.Danger);return end
		local ok,rConn=pcall(function()return inst[evtName]:Connect(fn())end)
		if ok and rConn then
			cd.robloxConn=rConn;table.insert(GuiBuilder.instances[inst].connections,cd)
			showNotif("✓ Connected: "..evtName,THEME.Success);GuiBuilder.refreshInstanceTab()
		else showNotif("❌ Not found: "..evtName,THEME.Danger) end
	end,true)
	for _,evtName in ipairs(EVENTS_BY_CLASS[inst.ClassName] or {}) do
		local b=el("TextButton",{Size=UDim2.new(1,0,0,22),BackgroundColor3=THEME.Panel,BorderSizePixel=0,Text=evtName,TextColor3=THEME.SubText,TextSize=10,Font=Enum.Font.Gotham,AutoButtonColor=false},evtScroll)
		corner(4,b);b.Activated:Connect(function()custEvtInp.Text=evtName end)
	end
	local evtLayout=evtScroll:FindFirstChildOfClass("UIListLayout")
	if evtLayout then evtScroll.CanvasSize=UDim2.new(0,0,0,evtLayout.AbsoluteContentSize.Y+8) end

	-- Connections list.
	if GuiBuilder.instances[inst] then
		for _,cd in ipairs(GuiBuilder.instances[inst].connections) do
			local cRow=el("Frame",{Size=UDim2.new(1,0,0,24),BackgroundColor3=THEME.Panel,BorderSizePixel=0},connListFrame)
			corner(4,cRow)
			el("TextLabel",{Size=UDim2.new(1,-50,1,0),Position=UDim2.new(0,6,0,0),BackgroundTransparency=1,Text="⚡ "..cd.event,TextColor3=THEME.Text,TextSize=10,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},cRow)
			local editB=el("TextButton",{Size=UDim2.new(0,40,0,18),Position=UDim2.new(1,-44,0,3),BackgroundColor3=THEME.Accent,BorderSizePixel=0,Text="Edit",TextColor3=THEME.Text,TextSize=9,Font=Enum.Font.GothamMedium,ZIndex=cRow.ZIndex+1},cRow)
			corner(3,editB)
			editB.Activated:Connect(function()
				openConnectionEditor(cd,function(updated)
					if cd.robloxConn then pcall(function()cd.robloxConn:Disconnect()end) end
					local fn=loadstring("return function()\n"..updated.code.."\nend")
					if fn then
						local ok,newC=pcall(function()return inst[updated.event]:Connect(fn())end)
						if ok and newC then cd.robloxConn=newC;showNotif("✓ Updated",THEME.Success) end
					end
				end)
			end)
		end
	end
	local connLayout=connListFrame:FindFirstChildOfClass("UIListLayout")
	if connLayout then connListFrame.CanvasSize=UDim2.new(0,0,0,connLayout.AbsoluteContentSize.Y+24) end
end

