local function collectRoots()
	local roots,seen={},{}
	local function scan(parent)
		if not parent then return end
		for _,child in ipairs(parent:GetChildren()) do
			if GuiBuilder.instances[child] and not seen[child] and not isSkipped(child) then
				seen[child]=true;table.insert(roots,child)
			end
		end
	end
	scan(editGui)
	scan(localPlayer:FindFirstChildOfClass("PlayerGui"))
	if gethui then pcall(function()
		local hui=gethui()
		if hui then
			for _,ch in ipairs(hui:GetChildren()) do
				if GuiBuilder.instances[ch] and not seen[ch] and ch~=screenGui then
					seen[ch]=true;table.insert(roots,ch)
				end
			end
		end
	end) end
	return roots
end

