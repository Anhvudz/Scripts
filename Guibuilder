		TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,
	},scriptFrame)
	scriptBox:GetPropertyChangedSignal("Text"):Connect(function()
		GuiBuilder.scriptCode=scriptBox.Text
