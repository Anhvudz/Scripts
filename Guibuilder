	el("UIListLayout",{FillDirection=Enum.FillDirection.Vertical,SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,1)},explorerScroll)
	el("UIPadding",{PaddingLeft=UDim.new(0,4),PaddingRight=UDim.new(0,4),PaddingTop=UDim.new(0,4)},explorerScroll)
	explorerBtn.Activated:Connect(function()
		explorerFrame.Visible=not explorerFrame.Visible
		if explorerFrame.Visible then buildExplorer(explorerScroll) end
	end)
	refreshBtn.Activated:Connect(function()
		if explorerFrame.Visible then buildExplorer(explorerScroll) end
	end)

	-- Tab bar.
	local tabBar=el("Frame",{Size=UDim2.new(1,0,0,32),Position=UDim2.new(0,0,0,36),BackgroundColor3=THEME.Surface,BorderSizePixel=0,ZIndex=101},mainFrame)
	el("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,2)},tabBar)
	el("UIPadding",{PaddingLeft=UDim.new(0,4),PaddingRight=UDim.new(0,4),PaddingTop=UDim.new(0,4),PaddingBottom=UDim.new(0,4)},tabBar)
	local contentArea=el("Frame",{Name="Content",Size=UDim2.new(1,0,1,-70),Position=UDim2.new(0,0,0,70),BackgroundTransparency=1,ZIndex=101,ClipsDescendants=true},mainFrame)

	local tabs,tabBtns={},{}
	local tabNames={"Main","Instance","Save/Load","Settings"}

	local function switchTab(idx)
		currentTab=idx
		for i,panel in ipairs(tabs) do panel.Visible=(i==idx) end
		for i,btn in ipairs(tabBtns) do
			tw(btn,{BackgroundColor3=i==idx and THEME.Accent or THEME.Panel,TextColor3=i==idx and THEME.Text or THEME.SubText},0.13)
		end
		if idx==2 then GuiBuilder.refreshInstanceTab() end
	end

	for i,name in ipairs(tabNames) do
		local btn=el("TextButton",{Size=UDim2.new(0.24,0,1,0),BackgroundColor3=i==1 and THEME.Accent or THEME.Panel,BorderSizePixel=0,Text=name,TextColor3=i==1 and THEME.Text or THEME.SubText,TextSize=10,Font=Enum.Font.GothamMedium,AutoButtonColor=false,ZIndex=102},tabBar)
		corner(5,btn);table.insert(tabBtns,btn)
		local panel=el("ScrollingFrame",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=4,ScrollBarImageColor3=THEME.Border,Visible=i==1,ZIndex=101},contentArea)
		el("UIListLayout",{FillDirection=Enum.FillDirection.Vertical,SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,5)},panel)
		el("UIPadding",{PaddingLeft=UDim.new(0,8),PaddingRight=UDim.new(0,8),PaddingTop=UDim.new(0,8),PaddingBottom=UDim.new(0,8)},panel)
		table.insert(tabs,panel)
		local ci=i;btn.Activated:Connect(function()switchTab(ci)end)
	end
	for _,panel in ipairs(tabs) do
		local layout=panel:FindFirstChildOfClass("UIListLayout")
		if layout then
			layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				panel.CanvasSize=UDim2.new(0,0,0,layout.AbsoluteContentSize.Y+16)
			end)
		end
	end

	-- =====================
	-- TAB 1: MAIN
	-- =====================
	local t1=tabs[1]
	createSectionHeader(t1,"GRID & INCREMENT")
	createSlider(t1,"Move Increment",1,50,1,function(v)GuiBuilder.moveInc=v end)
	createSlider(t1,"Resize Increment",1,50,1,function(v)GuiBuilder.resizeInc=v end)
	createSeparator(t1)
	createSectionHeader(t1,"CREATE INSTANCE")
	local _,classInp=createTextInput(t1,"Instance Class","e.g. Frame, TextLabel...")
	createButton(t1,"+ Create Instance",function()
		local cls=classInp.Text
		if cls=="" then showNotif("Enter a class name",THEME.Warning);return end
		local ok,newInst=pcall(function()return Instance.new(cls)end)
		if not ok or not newInst then showNotif("❌ Invalid: "..cls,THEME.Danger);return end
		if newInst:IsA("GuiObject") then pcall(function()newInst.Size=UDim2.new(0,50,0,50)end) end
		local parentTarget=GuiBuilder.selected or editGui
		newInst.Parent=parentTarget;tagInstance(newInst)
		showNotif("✓ Created "..cls.." → "..parentTarget.Name,THEME.Success)
		if explorerFrame.Visible then buildExplorer(explorerScroll) end
	end,true)
	createSeparator(t1)
	createSectionHeader(t1,"EDITOR MODE")
	createDropdown(t1,"Active Mode",{"Select","Move","Resize"},"Select",function(v)
		GuiBuilder.mode=v:lower();showNotif("Mode: "..v,THEME.Accent)
	end)
	createSeparator(t1)
	createSectionHeader(t1,"GUI SCRIPT")
	-- Multi-line script textbox.
	local scriptFrame=el("Frame",{Size=UDim2.new(1,0,0,110),BackgroundColor3=THEME.Surface,BorderSizePixel=0},t1)
	corner(6,scriptFrame) stroke(THEME.Border,1,scriptFrame)
	local scriptBox=el("TextBox",{
		Size=UDim2.new(1,-12,1,-8),Position=UDim2.new(0,6,0,4),
		BackgroundTransparency=1,PlaceholderText="-- Script runs on Play...",Text=GuiBuilder.scriptCode,
		TextColor3=THEME.Text,PlaceholderColor3=THEME.SubText,
		TextSize=11,Font=Enum.Font.Code,MultiLine=true,ClearTextOnFocus=false,
		TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,
	},scriptFrame)
	scriptBox:GetPropertyChangedSignal("Text"):Connect(function()
		GuiBuilder.scriptCode=scriptBox.Text
	end)
	-- Play / Stop row.
	local playRow=el("Frame",{Size=UDim2.new(1,0,0,32),BackgroundTransparency=1},t1)
	el("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,4)},playRow)
