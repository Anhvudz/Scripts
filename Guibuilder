-- Dropdown: list is rendered at screenGui level to avoid ClipsDescendants occlusion.
local function createDropdown(parent, label, options, default, onChange)
	local h=label and 52 or 32
	local c=el("Frame",{Size=UDim2.new(1,0,0,h),BackgroundTransparency=1},parent)
	if label then el("TextLabel",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Text=label,TextColor3=THEME.Text,TextSize=12,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left},c) end
	local dropBtn=el("TextButton",{Size=UDim2.new(1,0,0,30),Position=UDim2.new(0,0,0,label and 20 or 0),BackgroundColor3=THEME.Surface,BorderSizePixel=0,Text="",AutoButtonColor=false},c)
	corner(6,dropBtn) stroke(THEME.Border,1,dropBtn)
	local selLbl=el("TextLabel",{Size=UDim2.new(1,-28,1,0),Position=UDim2.new(0,8,0,0),BackgroundTransparency=1,Text=default or (options[1] or "Select..."),TextColor3=THEME.Text,TextSize=12,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left},dropBtn)
	el("TextLabel",{Size=UDim2.new(0,22,1,0),Position=UDim2.new(1,-24,0,0),BackgroundTransparency=1,Text="▾",TextColor3=THEME.SubText,TextSize=14},dropBtn)
	local selected=default or options[1]
	local open=false
	local activeList,activeOverlay=nil,nil
	local ITEM_H=24
	local function closeList()
		if activeOverlay and activeOverlay.Parent then activeOverlay:Destroy() end
		if activeList and activeList.Parent then
			local sz=activeList.Size.X.Offset
			tw(activeList,{Size=UDim2.new(0,sz,0,0)},0.1)
			local td=activeList
			task.delay(0.11,function() if td and td.Parent then td:Destroy() end end)
		end
		activeList=nil;activeOverlay=nil;open=false
	end
	dropBtn.Activated:Connect(function()
		if open then closeList();return end
		if not screenGui or not screenGui.Parent then return end
		open=true
		local ap=dropBtn.AbsolutePosition;local as=dropBtn.AbsoluteSize
		local tH=math.min(#options,5)*(ITEM_H+2)+8
		activeOverlay=el("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",ZIndex=4998},screenGui)
		activeOverlay.Activated:Connect(closeList)
		activeList=el("Frame",{Size=UDim2.new(0,as.X,0,0),Position=UDim2.new(0,ap.X,0,ap.Y+as.Y+2),BackgroundColor3=THEME.Surface,BorderSizePixel=0,ZIndex=4999,ClipsDescendants=true},screenGui)
		corner(6,activeList) stroke(THEME.Border,1,activeList)
		el("UIListLayout",{FillDirection=Enum.FillDirection.Vertical,SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,2)},activeList)
		el("UIPadding",{PaddingLeft=UDim.new(0,4),PaddingRight=UDim.new(0,4),PaddingTop=UDim.new(0,4),PaddingBottom=UDim.new(0,4)},activeList)
		for _,opt in ipairs(options) do
			local b=el("TextButton",{Size=UDim2.new(1,0,0,ITEM_H),BackgroundColor3=THEME.Panel,BorderSizePixel=0,Text=tostring(opt),TextColor3=opt==selected and THEME.Accent or THEME.Text,TextSize=11,Font=Enum.Font.Gotham,AutoButtonColor=false,ZIndex=5000},activeList)
			corner(4,b)
			b.MouseEnter:Connect(function() tw(b,{BackgroundColor3=THEME.Tertiary},0.1) end)
			b.MouseLeave:Connect(function() tw(b,{BackgroundColor3=THEME.Panel},0.1) end)
			b.Activated:Connect(function()
				selected=opt;selLbl.Text=tostring(opt);closeList()
				if onChange then onChange(opt) end
			end)
		end
		tw(activeList,{Size=UDim2.new(0,as.X,0,tH)},0.12)
	end)
	return c,function()return selected end,function(opts)options=opts end
end

