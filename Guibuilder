-- SELECTION OVERLAY
-- Adds yellow move handle + 8 blue resize handles directly on the selected instance.
-- =====================

local function hideSelectionOverlay()
	if selOverlay and selOverlay.Parent then
		pcall(function() selOverlay:Destroy() end)
	end
	selOverlay = nil
end

local function showSelectionOverlay(inst)
	hideSelectionOverlay()
	if not inst or not inst:IsA("GuiObject") then return end
	if GuiBuilder.isPlaying then return end

	selOverlay = el("Frame",{
		Name = OVERLAY_NAME,
		Size = UDim2.new(1,14,1,14), Position = UDim2.new(0,-7,0,-7),
		BackgroundTransparency = 1, BorderSizePixel = 0,
		ZIndex = 9000, ClipsDescendants = false,
	}, inst)
	stroke(THEME.Yellow, 1.5, selOverlay)

	-- Yellow move handle.
	local moveBtn = el("Frame",{
		Size = UDim2.new(0,18,0,18), Position = UDim2.new(0,-9,0,-9),
		BackgroundColor3 = THEME.Yellow, BorderSizePixel = 0, ZIndex = 9001,
	}, selOverlay)
	corner(9, moveBtn)
	el("TextLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="✥",TextColor3=Color3.new(0,0,0),TextSize=11,Font=Enum.Font.GothamBold,ZIndex=9002},moveBtn)

	-- Move logic: drags the actual instance (inst).
	local mDrag,mStart,mPos=false,nil,nil
	moveBtn.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
			mDrag=true;mStart=i.Position;mPos=inst.Position
		end
	end)
	local mc1=userInputService.InputChanged:Connect(function(i)
		if not mDrag then return end
		if i.UserInputType~=Enum.UserInputType.MouseMovement and i.UserInputType~=Enum.UserInputType.Touch then return end
		local dv=i.Position-mStart
		inst.Position=UDim2.new(mPos.X.Scale, mPos.X.Offset+dv.X, mPos.Y.Scale, mPos.Y.Offset+dv.Y)
	end)
	local mc2=userInputService.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then mDrag=false end
	end)
	addCleanup(mc1) addCleanup(mc2)

	-- 8 blue resize handles that resize inst.
	local anchors = {
		{Vector2.new(0,0),Vector2.new(-1,-1)},{Vector2.new(1,0),Vector2.new(1,-1)},
		{Vector2.new(0,1),Vector2.new(-1,1)},{Vector2.new(1,1),Vector2.new(1,1)},
		{Vector2.new(.5,0),Vector2.new(0,-1)},{Vector2.new(.5,1),Vector2.new(0,1)},
		{Vector2.new(0,.5),Vector2.new(-1,0)},{Vector2.new(1,.5),Vector2.new(1,0)},
	}
	for _, d in ipairs(anchors) do
		local anc, dir = d[1], d[2]
		local rh = el("Frame",{
			Size=UDim2.new(0,10,0,10),Position=UDim2.new(anc.X,dir.X*5,anc.Y,dir.Y*5),
			AnchorPoint=anc,BackgroundColor3=THEME.Blue,BorderSizePixel=0,ZIndex=9001,
		},selOverlay)
		corner(10,rh)
		local rDrag,rStart,rSz,rPs=false,nil,nil,nil
		rh.InputBegan:Connect(function(i)
			if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
			rDrag=true;rStart=i.Position;rSz=inst.Size;rPs=inst.Position
		end)
		local rc1=userInputService.InputChanged:Connect(function(i)
			if not rDrag then return end
			if i.UserInputType~=Enum.UserInputType.MouseMovement and i.UserInputType~=Enum.UserInputType.Touch then return end
			local dv=i.Position-rStart
			local w,h,x,y=rSz.X.Offset,rSz.Y.Offset,rPs.X.Offset,rPs.Y.Offset
			if anc.X==0 then w=math.max(10,w-dv.X);x=rPs.X.Offset+(rSz.X.Offset-w)
			elseif anc.X==1 then w=math.max(10,w+dv.X) end
			if anc.Y==0 then h=math.max(10,h-dv.Y);y=rPs.Y.Offset+(rSz.Y.Offset-h)
			elseif anc.Y==1 then h=math.max(10,h+dv.Y) end
			inst.Size=UDim2.new(rSz.X.Scale,w,rSz.Y.Scale,h)
			inst.Position=UDim2.new(rPs.X.Scale,x,rPs.Y.Scale,y)
		end)
		local rc2=userInputService.InputEnded:Connect(function(i)
			if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then rDrag=false end
		end)
		addCleanup(rc1) addCleanup(rc2)
	end
end

