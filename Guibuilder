local function createSlider(parent, label, min, max, default, onChange)
	local container = el("Frame", { Size = UDim2.new(1,0,0,46), BackgroundTransparency = 1 }, parent)
	local valLabel = el("TextLabel", { Size = UDim2.new(0,36,0,18), Position = UDim2.new(1,-36,0,0), BackgroundTransparency = 1, Text = tostring(default), TextColor3 = THEME.SubText, TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Right }, container)
	el("TextLabel", { Size = UDim2.new(1,-40,0,18), BackgroundTransparency = 1, Text = label, TextColor3 = THEME.Text, TextSize = 12, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left }, container)
	local track = el("Frame", { Size = UDim2.new(1,0,0,5), Position = UDim2.new(0,0,0,26), BackgroundColor3 = THEME.Border, BorderSizePixel = 0 }, container)
	corner(4, track)
	local fill = el("Frame", { Size = UDim2.new(0,0,1,0), BackgroundColor3 = THEME.Accent, BorderSizePixel = 0 }, track)
	corner(4, fill)
	local knob = el("Frame", { Size = UDim2.new(0,13,0,13), Position = UDim2.new(0,-6,0.5,-6), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 5 }, track)
	corner(10, knob)
	local value = default or min
	local dragging = false
	local function setValue(v)
		value = math.clamp(v, min, max)
		local pct = (value - min) / (max - min)
		fill.Size = UDim2.new(pct, 0, 1, 0)
		knob.Position = UDim2.new(pct, -6, 0.5, -6)
		valLabel.Text = tostring(math.round(value * 100) / 100)
		if onChange then onChange(value) end
	end
	local function fromInput(input)
		local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		setValue(min + (max - min) * pct)
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; fromInput(i) end
	end)
	local c1 = userInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromInput(i) end
	end)
	local c2 = userInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	addCleanup(c1) addCleanup(c2)
	setValue(value)
	return container, function() return value end, setValue
end

