local function ensureFolder()
	if not isfolder(FOLDER_NAME) then makefolder(FOLDER_NAME) end
end

local function saveGui(name)
	ensureFolder()
	local data={name=name,version="2",scriptCode=GuiBuilder.scriptCode,instances={}}
	local function serInst(inst,pid)
		if inst.Name==OVERLAY_NAME then return end
		local id=#data.instances+1
		local props={}
		for _,p in ipairs(SUPPORTED_PROPS[inst.ClassName] or {}) do
			local ok,v=pcall(function()return inst[p]end)
			if ok then props[p]=serializeValue(v) end
		end
		local conns={}
		local instData=GuiBuilder.instances[inst]
		if instData then
			for _,cd in ipairs(instData.connections or {}) do
				table.insert(conns,{event=cd.event,code=cd.code})
			end
		end
		table.insert(data.instances,{
			id=id,parentId=pid,className=inst.ClassName,props=props,connections=conns,
			draggable=instData and instData.draggable or false,
			source=instData and instData.loadstringSource,
		})
		for _,child in ipairs(inst:GetChildren()) do
			if GuiBuilder.instances[child] and child.Name~=OVERLAY_NAME then serInst(child,id) end
		end
	end
	for _,root in ipairs(collectRoots()) do
		if root==editGui then
			for _,child in ipairs(editGui:GetChildren()) do
				if GuiBuilder.instances[child] then serInst(child,0) end
			end
		else serInst(root,0) end
	end
	local ok,json=pcall(function()return httpService:JSONEncode(data)end)
	if ok then writefile(FOLDER_NAME.."/"..name..".gbf",json);return true,FOLDER_NAME.."/"..name..".gbf" end
	return false,"JSONEncode failed"
end

-- =====================
-- IMPORT - CONNECTION DETECTION
-- =====================

-- Try to extract function body lines from import script text, given the start line.
local function extractImportBody(codeLines, lineStart)
	local body={}
	local depth=0
	for i=lineStart,math.min(lineStart+50,#codeLines) do
		local ln=codeLines[i]
		local stripped=ln:match("^%s*(.-)%s*$") or ""
		-- Count depth based on keywords.
		for _ in ln:gmatch("%f[%a]function%f[%A]") do depth=depth+1 end
		for _ in ln:gmatch("%f[%a]do%f[%A]") do depth=depth+1 end
		for _ in ln:gmatch("%f[%a]then%f[%A]") do depth=depth+1 end
		local endCount=0
		for _ in ln:gmatch("%f[%a]end%f[%A]") do endCount=endCount+1 end
		depth=depth-endCount
		if i==lineStart then
			-- Skip the function(...) declaration line itself.
			if ln:match("function") then continue end
		end
		if endCount>0 and depth<=0 then break end
		table.insert(body,ln)
	end
	return table.concat(body,"\n")
end

-- After import execution: scan new instances for live connections and record them.
local function detectImportConnections(inst, codeLines)
	for _,evtName in ipairs(ALL_DETECT_EVENTS) do
		local sigOk,signal=pcall(function()return inst[evtName]end)
		if not sigOk or typeof(signal)~="RBXScriptSignal" then continue end
		local cok,conns=pcall(getconnections,signal)
		if not cok or not conns then continue end
		for _,conn in ipairs(conns) do
			if not conn.LuaConnection then continue end
			local fn=conn.Function
			if not fn then continue end
			if isexecutorclosure and isexecutorclosure(fn) then continue end
			-- Extract code from source.
			local code="-- "..evtName.." (auto-detected)"
			local infoOk,fnInfo=pcall(debug.getinfo,fn)
			if infoOk and fnInfo then
				local src=fnInfo.source or ""
				local lineStart=fnInfo.linedefined or -1
				-- Match if from our import chunk.
				if src:find(IMPORT_CHUNK,1,true) or src=="="..IMPORT_CHUNK then
					if lineStart>0 and #codeLines>0 then
						local extracted=extractImportBody(codeLines,lineStart)
						if extracted~="" then code=extracted end
					end
				end
			end
			if not GuiBuilder.instances[inst] then GuiBuilder.instances[inst]={connections={}} end
			table.insert(GuiBuilder.instances[inst].connections,{
				event=evtName,code=code,robloxConn=nil,
			})
		end
	end
end

