local function tagInstance(inst, src)
	GuiBuilder.instances[inst] = GuiBuilder.instances[inst] or {connections={},loadstringSource=src,draggable=false}
end

local function untagInstance(inst)
	if GuiBuilder.instances[inst] then
		for _,cd in ipairs(GuiBuilder.instances[inst].connections) do
			pcall(function() if cd.robloxConn then cd.robloxConn:Disconnect() end end)
		end
		GuiBuilder.instances[inst]=nil
	end
end

-- Check if an instance should be skipped (overlay, or not tagged).
local function isSkipped(inst)
	return inst.Name == OVERLAY_NAME or inst == mainFrame or inst == toggleBtn or inst == explorerFrame
end

