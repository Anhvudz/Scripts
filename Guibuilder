local function el(class, props, parent)
	local ok, inst = pcall(Instance.new, class)
	if not ok or not inst then warn("[GB] Instance.new failed: " .. tostring(class)); return nil end
	for k, v in pairs(props) do
		if v ~= nil then pcall(function() inst[k] = v end) end
	end
	if parent then pcall(function() inst.Parent = parent end) end
	return inst
end

